# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# App
APP_NAME=AmbientClimateCompanion API
APP_ENV=development
APP_DEBUG=false

# Google Cloud
# Path to your service account key JSON — local dev only, not needed on Cloud Run
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=ambient_climate
BIGQUERY_TABLE=weather_records

# OpenWeatherMap (get a free key at openweathermap.org)
OPENWEATHER_API_KEY=your-openweathermap-api-key
OPENWEATHER_CITY=Lausanne

# Shared secret between the M5Stack device and this backend
# Pick any strong string — the device must send the same value
API_KEY=changeme
