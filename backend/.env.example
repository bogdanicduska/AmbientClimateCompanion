# ============================================================
# Room Rhythm — backend environment variables
# Copy this file to .env and fill in the real values.
# Never commit the real .env file — it is gitignored.
# ============================================================

# ── Application ────────────────────────────────────────────
APP_NAME=AmbientClimateCompanion API
APP_ENV=development          # development | production
APP_DEBUG=false

# ── Google Cloud / BigQuery ────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=ambient_climate
BIGQUERY_TABLE=weather_records

# Path to service-account key — LOCAL DEV ONLY.
# On Cloud Run the service account is attached to the revision;
# leave this empty or omit it in production.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── OpenWeatherMap ─────────────────────────────────────────
OPENWEATHER_API_KEY=your-openweathermap-api-key
OPENWEATHER_CITY=Lausanne

# ── Device authentication ──────────────────────────────────
# Shared secret between the M5Stack firmware and this backend.
# Set this and update the device firmware constant AUTH_TOKEN to match.
DEVICE_AUTH_TOKEN=change_me_before_deploy

# ── OpenAI (speech features — STT / TTS / agent) ──────────
OPENAI_API_KEY=sk-...
OPENAI_TTS_MODEL=tts-1          # tts-1 (fast) | tts-1-hd (higher quality)
OPENAI_TTS_VOICE=nova           # alloy | echo | fable | onyx | nova | shimmer
OPENAI_STT_MODEL=whisper-1
OPENAI_STT_LANGUAGE=en

# ── Server ─────────────────────────────────────────────────
PORT=8080

# ── Test helpers (scripts only — not used by the app) ──────
TEST_DEVICE_ID=m5stack-duska-home
