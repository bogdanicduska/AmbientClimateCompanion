from m5stack import *
from m5ui import *
from uiflow import *
import utime
import network

setScreenColor(0x0D0D0D)

# -------------------------------------------------------
# Config
# -------------------------------------------------------
WIFI_NETWORKS = [
    ("LopezLed", "Chuma12345"),
    ("Pixel-AP",  "apmc1234"),
    ("iot-unil",  "4u6uch4hpY9pJ2f9"),
]

LAST_WIFI_FILE = "/flash/last_wifi.txt"
BACKEND_EVENTS = "https://ambient-climate-backend-977755576323.europe-west6.run.app/api/v1/events"
DEVICE_ID      = "m5stack-home-01"
AUTH_TOKEN     = "weather2026"

# -------------------------------------------------------
# WiFi helpers
# -------------------------------------------------------
def save_last_wifi(ssid):
    try:
        with open(LAST_WIFI_FILE, "w") as f: f.write(ssid)
    except: pass

def load_last_wifi():
    try:
        with open(LAST_WIFI_FILE, "r") as f: return f.read().strip()
    except: return None

def get_wifi_order():
    last = load_last_wifi()
    ordered = [i for i in WIFI_NETWORKS if i[0] == last] if last else []
    for i in WIFI_NETWORKS:
        if i not in ordered: ordered.append(i)
    return ordered

def wait_for_connection(timeout_sec=10):
    wlan = network.WLAN(network.STA_IF)
    start = utime.time()
    while utime.time() - start < timeout_sec:
        if wlan.isconnected(): return True, wlan.ifconfig()[0]
        wait_ms(300)
    return False, None

def try_connect_one(ssid, pwd):
    lcd.clear(0x0D0D0D)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("Connecting...", 10, 50, 0xFFFFFF)
    lcd.print(ssid, 10, 80, 0x00FFCC)
    try:
        import wifiCfg
        wifiCfg.doConnect(ssid, pwd)
    except Exception as e:
        return False, str(e)
    ok, ip = wait_for_connection(10)
    if ok:
        save_last_wifi(ssid)
        return True, ip
    return False, "Timeout"

def auto_connect_wifi():
    for ssid, pwd in get_wifi_order():
        ok, result = try_connect_one(ssid, pwd)
        if ok:
            return True
        lcd.clear(0x0D0D0D)
        lcd.font(lcd.FONT_DejaVu18)
        lcd.print("Failed: " + ssid, 10, 50, 0xFF4444)
        wait(2)
    return False

# -------------------------------------------------------
# Event sender — details always sent as a dict (JSON object)
# -------------------------------------------------------
def send_event(event_type, details=None):
    import urequests, ujson
    payload = {"device_id": DEVICE_ID, "event_type": event_type}
    if details is not None:
        payload["details"] = details  # dict, serialised properly by ujson
    r = urequests.post(
        BACKEND_EVENTS,
        headers={"Content-Type": "application/json",
                 "Authorization": "Bearer " + AUTH_TOKEN},
        data=ujson.dumps(payload)
    )
    status = r.status_code
    r.close()
    return status

# -------------------------------------------------------
# UI helpers
# -------------------------------------------------------
PASS_COLOR = 0x00FF66
FAIL_COLOR = 0xFF4444
SKIP_COLOR = 0xAAAAAA

def draw_header():
    lcd.clear(0x0D0D0D)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("Events endpoint test", 10, 5, 0xFFFFFF)
    lcd.line(0, 28, 320, 28, 0x2A2A2A)

ROW_START = 35
ROW_H     = 32

def draw_row(idx, label, status_text, color):
    y = ROW_START + idx * ROW_H
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print(label,       10,  y, 0xAAAAAA)
    lcd.print(status_text, 230, y, color)

def run_test(idx, label, event_type, details=None, expect=201):
    draw_row(idx, label, "...", SKIP_COLOR)
    try:
        code = send_event(event_type, details)
        if code == expect:
            draw_row(idx, label, "OK " + str(code), PASS_COLOR)
            return True
        else:
            draw_row(idx, label, "ERR " + str(code), FAIL_COLOR)
            return False
    except Exception as e:
        draw_row(idx, label, "EXC", FAIL_COLOR)
        return False

# -------------------------------------------------------
# Boot: WiFi
# -------------------------------------------------------
lcd.clear(0x0D0D0D)
lcd.font(lcd.FONT_DejaVu18)
lcd.print("Connecting to WiFi...", 10, 50, 0xFFFFFF)

if not auto_connect_wifi():
    lcd.clear(0x0D0D0D)
    lcd.print("No WiFi — aborting", 10, 50, 0xFF4444)
    raise SystemExit

draw_header()

# -------------------------------------------------------
# Test sequence (Option B: boot_recovered always, cache_loaded on sync)
#
#  idx  label            event_type           details (dict)
# -------------------------------------------------------
results = []

results.append(run_test(0, "boot_recovered",
    "boot_recovered",
    {"reason": "power_on"}))

results.append(run_test(1, "cache_loaded",
    "cache_loaded",
    {"timestamp": "2026-04-19T10:00:00Z"}))

results.append(run_test(2, "humidity_alert",
    "humidity_alert",
    {"value": 35.0, "threshold": 40}))

results.append(run_test(3, "air_quality_alert",
    "air_quality_alert",
    {"value": 210, "label": "Hazardous"}))

results.append(run_test(4, "wifi_disconnected",
    "wifi_disconnected"))

results.append(run_test(5, "announcement_spoken",
    "announcement_spoken",
    {"text": "Air quality is poor"}))

# -------------------------------------------------------
# Summary
# -------------------------------------------------------
passed = sum(1 for r in results if r)
total  = len(results)

lcd.line(0, ROW_START + total * ROW_H + 2, 320, ROW_START + total * ROW_H + 2, 0x2A2A2A)
summary_y = ROW_START + total * ROW_H + 8
if passed == total:
    lcd.print("All " + str(total) + " passed!", 10, summary_y, PASS_COLOR)
else:
    lcd.print(str(passed) + "/" + str(total) + " passed", 10, summary_y, FAIL_COLOR)
