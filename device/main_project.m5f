    except: pass
    try: update_recovery_card()
    except: pass
    try: update_strain_tile()
    except: pass
    try: update_climate_tile()
    except: pass
    try: update_air_tile()
    except: pass
    try: update_status_line()
    except: pass

# -------------------------------------------------------
# Speech / Coach — touch menu under btnC
#
# Reuses the I2S0 speaker↔mic handoff trick from speech_debug.py:
# constructing a fresh I2S(NUM0, mode=MASTER_PDM, ...) forcibly reclaims
# the peripheral from speaker-TX so we can record. _release_mic() drops
# the input config so the next speaker.playWAV can reconfigure for output.
# The announcer respects _speech_busy so it cannot collide on I2S0.
# -------------------------------------------------------
DIAG_LOG_PATH = "/flash/diag.log"


def _diag(msg):
    try:
        print(msg)
    except Exception:
        pass
    try:
        with open(DIAG_LOG_PATH, "a") as _f:
            _f.write(str(msg) + "\n")
    except Exception:
        pass


def _diag_reset():
    try:
        with open(DIAG_LOG_PATH, "w") as _f:
            _f.write("--- diag boot ---\n")
    except Exception:
        pass


def mount_sd():
    if not _HAS_SDCARD:
        return False
    try:
        uos.listdir("/sd")
        return True
    except Exception:
        pass
    try:
        from machine import Pin as _SDPin
        sd = SDCard(slot=2, sck=_SDPin(23), miso=_SDPin(33), mosi=_SDPin(19), freq=10000000)
    except Exception as e:
        _diag("SDCard ctor failed: " + str(e)[:40])
        return False
    fn = getattr(uos, "mountsd", None)
    if fn:
        try:
            fn(sd, "/sd")
            return True
        except Exception:
            pass
    try:
        uos.mount(sd, "/sd")
        return True
    except Exception as e:
        _diag("SD mount failed: " + str(e)[:40])
        return False


def _speech_auth_headers():
    return {
        "Authorization": "Bearer " + AUTH_TOKEN,
        "Content-Type":  "application/json",
    }


def _release_speaker():
    """Wait for any in-progress speaker DMA to drain. The actual I2S0 mode
    flip back to mic-RX is done by constructing a fresh I2S(NUM0, ...) inside
    _init_mic — see the I2S0-handoff comment block above."""
    if not _speaker_used:
        return
    idle_ms = utime.ticks_diff(utime.ticks_ms(), _speaker_last_play_ms)
    if idle_ms < 800:
        utime.sleep_ms(800 - idle_ms)
    gc.collect()


def _init_mic():
    """Forcibly take I2S0 in MASTER_PDM mode. Bypasses MicrophonePDM."""
    global _MIC

    if not _HAS_I2S:
        _diag("I2S unavailable — cannot init mic")
        return False

    if _MIC is not None:
        try:
            _MIC.deinit()
        except Exception:
            pass
        _MIC = None
        gc.collect()

    try:
        from machine import Pin as _MicPin
        _MIC = I2S(
            I2S.NUM0,
            ws=_MicPin(MIC_WS_PIN),
            sdin=_MicPin(MIC_DATA_PIN),
            mode=I2S.MASTER_PDM,
            dataformat=I2S.B16,
            channelformat=I2S.ONLY_RIGHT,
            samplerate=RECORD_RATE,
            dmacount=I2S_DMA_COUNT,
            dmalen=I2S_DMA_LEN,
        )
        _diag("I2S mic init OK")
        return True
    except Exception as e:
        _diag("I2S mic init FAIL: " + str(e)[:40])
        _MIC = None
        return False


def _release_mic():
    global _MIC
    if _MIC is None:
        return
    try:
        _MIC.deinit()
    except Exception:
        pass
    _MIC = None
    gc.collect()
    utime.sleep_ms(200)


def _wav_header(data_size, sample_rate=RECORD_RATE, bits=16, channels=1):
    byte_rate   = sample_rate * channels * bits // 8
    block_align = channels * bits // 8
    riff_size   = 36 + data_size
    h = bytearray(44)
    h[0:4]   = b"RIFF"
    h[4:8]   = riff_size.to_bytes(4, "little")
    h[8:12]  = b"WAVE"
    h[12:16] = b"fmt "
    h[16:20] = (16).to_bytes(4, "little")
    h[20:22] = (1).to_bytes(2, "little")
    h[22:24] = channels.to_bytes(2, "little")
    h[24:28] = sample_rate.to_bytes(4, "little")
    h[28:32] = byte_rate.to_bytes(4, "little")
    h[32:34] = block_align.to_bytes(2, "little")
    h[34:36] = (bits).to_bytes(2, "little")
    h[36:40] = b"data"
    h[40:44] = data_size.to_bytes(4, "little")
    return h


def record_question():
    try:
        uos.remove(RECORD_PATH)
    except Exception:
        pass

    _release_speaker()
    if not _init_mic():
        return False, "MIC init failed", 0

    f = None
    try:
        f = open(RECORD_PATH, "wb")
        f.write(b"\x00" * 44)

        buf       = array.array("h", [0] * I2S_READ_SAMPLES)
        buf_bytes = I2S_READ_SAMPLES * 2
        gain      = MIC_GAIN
        max16     = 32767
        min16     = -32768

        target_bytes = RECORD_SECONDS * RECORD_RATE * 2
        data_bytes   = 0
        t_start      = utime.ticks_ms()
        deadline_ms  = (RECORD_SECONDS + 2) * 1000

        while data_bytes < target_bytes:
            if utime.ticks_diff(utime.ticks_ms(), t_start) > deadline_ms:
                break
            try:
                n = _MIC.readinto(buf)
            except Exception as _re:
                _diag("readinto err: " + str(_re)[:40])
                break

            if n is None:
                n = buf_bytes
            if n <= 0:
                continue

            samples = n // 2
            for i in range(samples):
                v = buf[i] * gain
                if v > max16:
                    v = max16
                elif v < min16:
                    v = min16
                buf[i] = v

            if n == buf_bytes:
                f.write(buf)
            else:
                f.write(memoryview(buf)[:samples])
            data_bytes += n

            if _wdt is not None:
                try: _wdt.feed()
                except Exception: pass

        f.seek(0)
        f.write(_wav_header(data_bytes))
        f.flush()
        f.close()
        f = None

        _release_mic()

        try:
            size = uos.stat(RECORD_PATH)[6]
        except Exception:
            size = 0

        if data_bytes <= 0 or size <= 44:
            return False, "tiny file", size

        gc.collect()
        utime.sleep_ms(400)
        return True, "ok", size

    except Exception as e:
        if f is not None:
            try: f.close()
            except Exception: pass
        _release_mic()
        gc.collect()
        return False, str(e)[:60], 0


def transcribe_wav(wav_path):
    try:
        size = uos.stat(wav_path)[6]
    except Exception:
        return False, "no recording on disk"
    if size == 0:
        return False, "0-byte recording"

    try:
        with open(wav_path, "rb") as f:
            wav_bytes = f.read()
        b64 = ubinascii.b2a_base64(wav_bytes).decode("utf-8").rstrip("\n")
        del wav_bytes
        gc.collect()

        body = ujson.dumps({
            "device_id": DEVICE_ID,
            "audio_b64": b64,
            "format":    "wav",
        }).encode("utf-8")
        del b64
        gc.collect()

        r = urequests.post(SPEECH_BACKEND + "/stt", data=body, headers=_speech_auth_headers())
        del body
        gc.collect()

        if r.status_code != 200:
            try: err = r.text
            except Exception: err = ""
            r.close()
            return False, "HTTP {0}: {1}".format(r.status_code, str(err)[:50])

        data = r.json()
        r.close()
        d = data.get("data", {}) if isinstance(data, dict) else {}
        text = d.get("transcript") or d.get("text") or d.get("transcription") or ""
        return True, text
    except Exception as e:
        return False, str(e)[:60]


def fetch_tts_wav(text):
    try:
        body = ujson.dumps({
            "device_id": DEVICE_ID,
            "text":      text,
            "format":    "wav",
        }).encode("utf-8")

        url = SPEECH_BACKEND + "/tts?raw=1&profile=m5stack"
        r = urequests.post(url, data=body, headers=_speech_auth_headers())
        if r.status_code != 200:
            r.close()
            return False, "HTTP " + str(r.status_code)

        try:
            content = r.content
        except Exception as e:
            r.close()
            return False, "no body: " + str(e)
        r.close()

        if not content or len(content) <= 1024 or not content.startswith(b"RIFF"):
            return False, "bad WAV body"

        last_err = "no path"
        for candidate in WAV_PATHS:
            try:
                with open(candidate, "wb") as f:
                    f.write(content)
                size = len(content)
                _diag("WAV saved: " + candidate + " size=" + str(size))
                del content
                gc.collect()
                return True, candidate
            except Exception as e:
                last_err = "{0}: {1}".format(candidate, e)
        return False, last_err
    except Exception as e:
        return False, str(e)[:60]


def play_wav_file(wav_path):
    global _speaker_used, _speaker_last_play_ms
    try:
        wav_size = uos.stat(wav_path)[6]
    except Exception:
        wav_size = 0
    bytes_per_sec = WAV_RATE * (WAV_BITS // 8)
    est_secs = max(1.0, (wav_size - 44) / float(bytes_per_sec)) if wav_size else 3.0
    if est_secs > 30:
        est_secs = 30
    gc.collect()
    try:
        speaker.playWAV(
            wav_path,
            rate=WAV_RATE,
            data_format=speaker.F16B,
            channel=speaker.CHN_R,
            volume=PLAY_VOLUME,
        )
    except Exception as e:
        return False, str(e)[:50]
    try:
        wait_ms(int(est_secs * 1000) + 500)
    except Exception:
        utime.sleep(est_secs + 0.5)
    _speaker_used         = True
    _speaker_last_play_ms = utime.ticks_ms()
    return True, "ok"


# --- Coach orb / breathing helpers --------------------------------------

def _smoothstep(t):
    if t <= 0.0: return 0.0
    if t >= 1.0: return 1.0
    return t * t * (3.0 - 2.0 * t)


def _coach_draw_phase_label(phase):
    lcd.rect(0, 8, 320, 32, COACH_BG, COACH_BG)
    lcd.font(_COACH_FONT_MED)
    lcd.setCursor(PHASE_LABEL_X.get(phase, 130), 12)
    lcd.setColor(PHASE_TEXT_COLOR)
    lcd.print(phase)


def _coach_draw_orb(radius):
    """Solid coral disc on dark bg — no halo. UIFlow1's lcd.circle() fill
    uses polygon approximation; any overlapping ring exposes triangular
    edges, so we render just one filled circle."""
    wipe_r = COACH_R_MAX + ORB_WIPE_MARGIN
    lcd.rect(COACH_CX - wipe_r, COACH_CY - wipe_r, wipe_r * 2, wipe_r * 2, COACH_BG, COACH_BG)
    lcd.circle(COACH_CX, COACH_CY, radius, ORB_COLOR, ORB_COLOR)


def _coach_draw_countdown(t_remaining):
    lcd.rect(135, 182, 50, 38, COACH_BG, COACH_BG)
    lcd.font(_COACH_FONT_BIG)
    digit = str(int(t_remaining))
    half_w = 12 if len(digit) == 1 else 24
    lcd.setCursor(COACH_CX - half_w, 184)
    lcd.setColor(ORB_COLOR)
    lcd.print(digit)


def _coach_draw_cycle_dots(cycles_completed, total_cycles):
    DOT_R   = 5
    SPACING = 16
    total_w = max(0, total_cycles - 1) * SPACING
    start_x = COACH_CX - total_w // 2
    y       = 226
    lcd.rect(0, y - DOT_R - 1, 320, DOT_R * 2 + 2, COACH_BG, COACH_BG)
    for i in range(total_cycles):
        x   = start_x + i * SPACING
        col = ORB_COLOR if i < cycles_completed else CYCLE_DOT_DIM
        lcd.circle(x, y, DOT_R, col, col)


def _coach_feed_wdt():
    if _wdt is not None:
        try: _wdt.feed()
        except Exception: pass


class _CoachAbort(Exception):
    """Raised inside the breathing loop when the user cancels (Btn A or
    a touch tap). Bubbles out of all three nested loops so we can show a
    'Stopped' card and return to the menu cleanly."""
    pass


def _coach_check_abort():
    """Return True if the user wants to stop the breathing session.
    Accepts btnA poll OR any touch tap — touch is independent of button
    polling quirks and works even if the runtime quietly consumes presses."""
    try:
        if btnA.wasPressed():
            return True
    except Exception:
        pass
    if _HAS_TOUCH:
        try:
            if _touch.status():
                return True
        except Exception:
            pass
    return False


def _coach_wait_release():
    """Block until the touchscreen reports no contact. Used after we return
    from an action to consume the still-held press."""
    if not _HAS_TOUCH:
        return
    deadline = utime.ticks_ms() + 1500
    while True:
        try:
            if not _touch.status():
                return
        except Exception:
            return
        if utime.ticks_diff(deadline, utime.ticks_ms()) <= 0:
            return
        utime.sleep_ms(20)


def _coach_wait_dismiss(timeout_ms):
    utime.sleep_ms(300)
    end = utime.ticks_ms() + timeout_ms
    while utime.ticks_diff(end, utime.ticks_ms()) > 0:
        if _HAS_TOUCH:
            try:
                if _touch.status():
                    _coach_wait_release()
                    return
            except Exception:
                pass
        if btnA.wasPressed() or btnB.wasPressed() or btnC.wasPressed():
            return
        utime.sleep_ms(40)
        _coach_feed_wdt()


def _coach_voice_path(phase):
    fname = COACH_VOICE_WAVS.get(phase)
    if not fname:
        return None
    if _sd_ok:
        return "/sd/" + fname
    return "/flash/" + fname


def _ensure_coach_voice_assets():
    needed = []
    for phase in ("INHALE", "HOLD", "EXHALE"):
        path = _coach_voice_path(phase)
        if not path:
            continue
        try:
            uos.stat(path)
        except Exception:
            needed.append((phase, path))
    if not needed:
        return

    setScreenColor(COACH_BG)
    lcd.font(_COACH_FONT_MED)
    lcd.setCursor(20, 100)
    lcd.setColor(ORB_COLOR)
    lcd.print("Caching voice...")
    lcd.font(_COACH_FONT_SM)
    lcd.setCursor(20, 140)
    lcd.setColor(COACH_TITLE_DIM)
    lcd.print("First-time setup")

    for phase, path in needed:
        ok, info = fetch_tts_wav(phase.lower())
        if not ok:
            _diag("voice asset fetch failed: " + phase + " " + str(info))
            continue
        try:
            with open(info, "rb") as src:
                with open(path, "wb") as dst:
                    while True:
                        chunk = src.read(2048)
                        if not chunk:
                            break
                        dst.write(chunk)
        except Exception as e:
            _diag("voice asset copy failed: " + str(e)[:40])
        gc.collect()


def _play_phase_cue(phase):
    """Fire-and-forget word at phase start. Non-blocking — DMA continues
    after the call returns, so the orb keeps animating."""
    global _speaker_used, _speaker_last_play_ms
    path = _coach_voice_path(phase)
    if not path:
        return
    try:
        uos.stat(path)
    except Exception:
        return
    try:
        speaker.playWAV(path,
                        rate=WAV_RATE,
                        data_format=speaker.F16B,
                        channel=speaker.CHN_R,
                        volume=PLAY_VOLUME)
        _speaker_used         = True
        _speaker_last_play_ms = utime.ticks_ms()
    except Exception as e:
        print("phase cue err:", e)


def run_coach_session(tech):
    """Run one breathing session. Btn A or any touch tap cancels."""
    _release_mic()
    _release_speaker()

    setScreenColor(COACH_BG)

    # Intro card
    lcd.rect(0, 0, 320, 240, COACH_BG, COACH_BG)
    lcd.font(_COACH_FONT_MED)
    lcd.setCursor(20, 80)
    lcd.setColor(PHASE_TEXT_COLOR)
    lcd.print(tech["name"][:38])
    lcd.setCursor(20, 116)
    lcd.setColor(0xAAAAAA)
    lcd.print(tech["subtitle"][:38])
    lcd.setCursor(20, 152)
    lcd.setColor(0x556677)
    lcd.print("Get ready...")
    lcd.font(_COACH_FONT_SM)
    lcd.setCursor(20, 210)
    lcd.setColor(COACH_TITLE_DIM)
    lcd.print("A or tap screen to stop")
    utime.sleep(1.5)

    # Drain stale presses / touches from before the session starts.
    try: btnA.wasPressed()
    except Exception: pass
    if _HAS_TOUCH:
        _coach_wait_release()

    setScreenColor(COACH_BG)

    cycles    = tech["cycles"]
    phases    = tech["phases"]
    current_r = COACH_R_MIN
    aborted   = False

    try:
        for cycle in range(1, cycles + 1):
            _coach_draw_cycle_dots(cycle - 1, cycles)
            for (phase, secs) in phases:
                _coach_draw_phase_label(phase)
                _play_phase_cue(phase)

                if phase == "INHALE":
                    start_r, end_r = current_r, COACH_R_MAX
                elif phase == "EXHALE":
                    start_r, end_r = current_r, COACH_R_MIN
                else:
                    start_r, end_r = current_r, current_r

                total_frames = secs * COACH_FPS
                for f in range(total_frames):
                    if _coach_check_abort():
                        raise _CoachAbort()

                    frame_start = utime.ticks_ms()
                    progress    = (f + 1) / total_frames if total_frames else 1.0
                    eased       = _smoothstep(progress)
                    radius      = int(start_r + (end_r - start_r) * eased)
                    _coach_draw_orb(radius)

                    if f % COACH_FPS == 0:
                        t_remaining = secs - (f // COACH_FPS)
                        _coach_draw_countdown(t_remaining)
                        _coach_feed_wdt()

                    elapsed  = utime.ticks_diff(utime.ticks_ms(), frame_start)
                    sleep_ms = COACH_FRAME_MS - elapsed
                    if sleep_ms > 0:
                        utime.sleep_ms(sleep_ms)

                current_r = end_r
    except _CoachAbort:
        aborted = True

    if aborted:
        setScreenColor(COACH_BG)
        lcd.font(_COACH_FONT_MED)
        lcd.setCursor(20, 100)
        lcd.setColor(PHASE_TEXT_COLOR)
        lcd.print("Stopped")
        lcd.setCursor(20, 140)
        lcd.setColor(0x556677)
        lcd.print(tech["name"][:38])
        utime.sleep(1)
        if _HAS_TOUCH:
            _coach_wait_release()
        return

    _coach_draw_cycle_dots(cycles, cycles)

    setScreenColor(COACH_BG)
    lcd.font(_COACH_FONT_MED)
    lcd.setCursor(20, 80)
    lcd.setColor(ORB_COLOR)
    lcd.print("Done.")
    lcd.setCursor(20, 116)
    lcd.setColor(PHASE_TEXT_COLOR)
    lcd.print(tech["name"][:38])
    lcd.setCursor(20, 152)
    lcd.setColor(0x556677)
    lcd.print("Tap to continue")
    _coach_wait_dismiss(3000)


# --- Meditation ---------------------------------------------------------

def _wrap_text(text, max_chars):
    words = text.split(" ")
    lines = []
    current = ""
    for w in words:
        if not current:
            current = w
        elif len(current) + 1 + len(w) <= max_chars:
            current = current + " " + w
        else:
            lines.append(current)
            current = w
    if current:
        lines.append(current)
    return lines


def _meditation_prompt_path(prompt_id):
    """Per-prompt cache path — different namespace from coach voice cues."""
    base = "/sd/" if _sd_ok else "/flash/"
    return base + "med_" + str(prompt_id) + ".wav"


def _ensure_meditation_prompts(prompts):
    """Cache the TTS for every prompt to local storage on first run.
    Returns the list of {path, time_s} for the prompts that were cached
    successfully — any that failed are silently dropped so the session
    can still run with reduced narration."""
    cached = []
    for p in prompts:
        pid  = p.get("id")
        text = p.get("text", "")
        time_s = p.get("time_s", 0)
        if not pid or not text:
            continue

        path = _meditation_prompt_path(pid)
        try:
            uos.stat(path)
            cached.append({"path": path, "time_s": time_s})
            continue
        except Exception:
            pass

        ok, info = fetch_tts_wav(text)
        if not ok:
            _diag("med prompt fetch failed: " + str(pid) + " " + str(info))
            continue
        # fetch_tts_wav saved to WAV_PATHS — copy to the meditation-specific
        # path so a later answer playback or another prompt doesn't overwrite it.
        try:
            with open(info, "rb") as src:
                with open(path, "wb") as dst:
                    while True:
                        chunk = src.read(2048)
                        if not chunk:
                            break
                        dst.write(chunk)
            cached.append({"path": path, "time_s": time_s})
        except Exception as e:
            _diag("med prompt copy failed: " + str(e)[:40])
        gc.collect()
    return cached


def _play_meditation_prompt(path):
    """Fire-and-forget WAV play. DMA continues after this returns so the
    orb keeps animating while the prompt narrates."""
    global _speaker_used, _speaker_last_play_ms
    try:
        speaker.playWAV(path,
                        rate=WAV_RATE,
                        data_format=speaker.F16B,
                        channel=speaker.CHN_R,
                        volume=PLAY_VOLUME)
        _speaker_used         = True
        _speaker_last_play_ms = utime.ticks_ms()
    except Exception as e:
        _diag("med prompt play err: " + str(e)[:40])


def _run_meditation(session_id="calm"):
    """Fetch a meditation script from /speech/meditation, cache prompt
    audios on first run, then render a slow-pulse orb while playing
    prompts at scheduled times. Btn A or any touch tap cancels."""
    _release_mic()
    _release_speaker()

    # Loading card while we fetch the script + cache audio
    setScreenColor(COACH_BG)
    lcd.font(_COACH_FONT_MED)
    lcd.setCursor(20, 110)
    lcd.setColor(COACH_TITLE_DIM)
    lcd.print("Loading...")

    try:
        url = SPEECH_BACKEND + "/meditation?session=" + session_id
        r = urequests.get(url, headers=_speech_auth_headers())
        if r.status_code != 200:
            r.close()
            _draw_ask_status("Meditation HTTP " + str(r.status_code))
            _coach_wait_dismiss(3000)
            return
        data = r.json()
        r.close()
        session = data.get("data", {}) if isinstance(data, dict) else {}
    except Exception as e:
        _draw_ask_status("Meditation error", str(e)[:35])
        _coach_wait_dismiss(3000)
        return

    prompts = session.get("prompts") if session else None
    if not prompts:
        _draw_ask_status("No script", session_id[:35])
        _coach_wait_dismiss(3000)
        return

    title       = session.get("title", "Meditation")
    duration_s  = session.get("duration_s", 180)
    breath_in   = session.get("breath_in_s",  6)
    breath_out  = session.get("breath_out_s", 6)
    cycle_s     = max(2, breath_in + breath_out)

    # Cache prompts (first run takes a few seconds; later runs are instant)
    setScreenColor(COACH_BG)
    lcd.font(_COACH_FONT_MED)
    lcd.setCursor(20, 100)
    lcd.setColor(ORB_COLOR)
    lcd.print(title[:30])
    lcd.font(_COACH_FONT_SM)
    lcd.setCursor(20, 140)
    lcd.setColor(COACH_TITLE_DIM)
    lcd.print("Preparing audio...")

    cached = _ensure_meditation_prompts(prompts)
    if not cached:
        _draw_ask_status("Prompt cache failed")
        _coach_wait_dismiss(3000)
        return

    # Title bar + cancel hint
    setScreenColor(COACH_BG)
    lcd.font(_COACH_FONT_MED)
    lcd.setCursor(20, 14)
    lcd.setColor(PHASE_TEXT_COLOR)
    lcd.print(title[:30])
    lcd.font(_COACH_FONT_SM)
    lcd.setCursor(20, 215)
    lcd.setColor(COACH_TITLE_DIM)
    lcd.print("A or tap to stop")

    # Drain stale presses / touches from the loading screen.
    try: btnA.wasPressed()
    except Exception: pass
    if _HAS_TOUCH:
        _coach_wait_release()

    t_start         = utime.ticks_ms()
    next_prompt_idx = 0
    aborted         = False
    last_radius     = -1

    try:
        while True:
            if _coach_check_abort():
                aborted = True
                break

            elapsed_s = utime.ticks_diff(utime.ticks_ms(), t_start) / 1000.0
            if elapsed_s >= duration_s:
                break

            # Fire any prompts that have come due since the last frame.
            while next_prompt_idx < len(cached) and elapsed_s >= cached[next_prompt_idx]["time_s"]:
                _play_meditation_prompt(cached[next_prompt_idx]["path"])
                next_prompt_idx += 1

            # Slow breath rhythm: smoothstep up over breath_in, smoothstep
            # down over breath_out. The orb is purely a focus point here —
            # not a strict cue like in Box Breathing.
            cycle_pos = elapsed_s % cycle_s
            if cycle_pos < breath_in:
                t = cycle_pos / breath_in if breath_in else 1.0
                radius = int(COACH_R_MIN + (COACH_R_MAX - COACH_R_MIN) * _smoothstep(t))
            else:
                t = (cycle_pos - breath_in) / breath_out if breath_out else 1.0
                radius = int(COACH_R_MAX + (COACH_R_MIN - COACH_R_MAX) * _smoothstep(t))

            # Only redraw the orb when the radius actually changes —
            # halves the LCD work in the steady state.
            if radius != last_radius:
                _coach_draw_orb(radius)
                last_radius = radius

            _coach_feed_wdt()
            utime.sleep_ms(150)
    except Exception as e:
        _diag("meditation loop err: " + str(e)[:40])

    if aborted:
        setScreenColor(COACH_BG)
        lcd.font(_COACH_FONT_MED)
        lcd.setCursor(20, 100)
        lcd.setColor(PHASE_TEXT_COLOR)
        lcd.print("Stopped")
        lcd.setCursor(20, 140)
        lcd.setColor(0x556677)
        lcd.print(title[:38])
        utime.sleep(1)
        if _HAS_TOUCH:
            _coach_wait_release()
        return

    setScreenColor(COACH_BG)
    lcd.font(_COACH_FONT_MED)
    lcd.setCursor(20, 80)
    lcd.setColor(ORB_COLOR)
    lcd.print("Done.")
    lcd.setCursor(20, 116)
    lcd.setColor(PHASE_TEXT_COLOR)
    lcd.print(title[:38])
    lcd.setCursor(20, 152)
    lcd.setColor(0x556677)
    lcd.print("Tap to continue")
    _coach_wait_dismiss(3000)


# --- Voice Ask ----------------------------------------------------------

def _draw_ask_status(title, subtitle=""):
    setScreenColor(COACH_BG)
    lcd.font(_COACH_FONT_MED)
    lcd.setCursor(20, 90)
    lcd.setColor(ORB_COLOR)
    lcd.print(title[:30])
    if subtitle:
        lcd.font(_COACH_FONT_SM)
        lcd.setCursor(20, 130)
        lcd.setColor(COACH_TITLE_DIM)
        lcd.print(subtitle[:38])


def _draw_answer_card(answer):
    setScreenColor(COACH_BG)
    lcd.font(_COACH_FONT_SM)
    lcd.setCursor(8, 14)
    lcd.setColor(ORB_COLOR)
    lcd.print("Coach")
    # Body in the small font so long answers fit: ~26 chars/line, up to 7 lines
    # (was 22 chars x 5 lines in the larger font). The full answer is always
    # spoken regardless; if it STILL overflows, mark the last line with an
    # ellipsis instead of silently dropping the rest.
    lcd.font(_COACH_FONT_SM)
    _ANS_MAX_LINES = 7
    _ANS_LINE_H    = 24
    all_lines = _wrap_text(answer, 26)
    lines     = all_lines[:_ANS_MAX_LINES]
    if len(all_lines) > _ANS_MAX_LINES and lines:
        lines[-1] = lines[-1][:24] + "..."
    total_h = len(lines) * _ANS_LINE_H
    start_y = max(40, (240 - total_h) // 2)
    for i, line in enumerate(lines):
        text_w = len(line) * 11
        x      = max(8, (320 - text_w) // 2)
        lcd.setCursor(x, start_y + i * _ANS_LINE_H)
        lcd.setColor(PHASE_TEXT_COLOR)
        lcd.print(line)
    lcd.setCursor(110, 222)
    lcd.setColor(COACH_TITLE_DIM)
    lcd.print("tap to continue")


def _run_ask_session():
    """Voice question: record → STT → /speech/ask (LLM agent) → TTS → play."""
    setScreenColor(COACH_BG)
    lcd.font(_COACH_FONT_MED)
    lcd.setCursor(20, 90)
    lcd.setColor(ORB_COLOR)
    lcd.print("Listening...")
    lcd.font(_COACH_FONT_SM)
    lcd.setCursor(20, 130)
    lcd.setColor(PHASE_TEXT_COLOR)
    lcd.print("Speak now (" + str(RECORD_SECONDS) + "s)")

    ok, info, size = record_question()
    if not ok:
        _draw_ask_status("Record failed", str(info)[:35])
        _coach_wait_dismiss(3000)
        return

    _draw_ask_status("Thinking...", "Transcribing")
    ok, text = transcribe_wav(RECORD_PATH)
    if not ok:
        _draw_ask_status("STT failed", str(text)[:35])
        _coach_wait_dismiss(3000)
        return
    if not text:
        _draw_ask_status("Did not hear you", "Try louder/closer")
        _coach_wait_dismiss(3000)
        return

    _diag("ASK text: " + str(text)[:60])
    _draw_ask_status("Asking...", text[:35])

    try:
        body = ujson.dumps({"device_id": DEVICE_ID, "question": text}).encode("utf-8")
        r = urequests.post(SPEECH_BACKEND + "/ask",
                           data=body, headers=_speech_auth_headers())
        if r.status_code != 200:
            try: err = r.text
            except Exception: err = ""
            r.close()
            _draw_ask_status("ASK HTTP " + str(r.status_code), str(err)[:35])
            _coach_wait_dismiss(4000)
            return
        data = r.json()
        r.close()
        d      = data.get("data", {}) if isinstance(data, dict) else {}
        answer = d.get("answer", "")
    except Exception as e:
        _draw_ask_status("ASK error", str(e)[:35])
        _coach_wait_dismiss(3000)
        return

    if not answer:
        _draw_ask_status("No answer", "")
        _coach_wait_dismiss(3000)
        return

    _diag("ASK answer: " + str(answer)[:80])
    _draw_answer_card(answer)

    ok, result = fetch_tts_wav(answer)
    if ok:
        play_wav_file(result)

    _coach_wait_dismiss(8000)


# --- Coach menu screen (under btnC) -------------------------------------

def _menu_item_display(item):
    kind = item["kind"]
    if kind == "ask":
        return "Ask",          "Weather, room, anything"
    if kind == "breathing":
        tech = COACH_TECHNIQUES[item["tech_idx"]]
        return tech["name"], tech["subtitle"]
    if kind == "meditation":
        return "Meditation",   "Choose a session"
    return "", ""


def _coach_row_y(row):
    return COACH_ROW_TOP + row * COACH_ROW_PITCH


def _coach_row_at(y):
    if y < COACH_ROW_TOP:
        return -1
    rel = y - COACH_ROW_TOP
    row = rel // COACH_ROW_PITCH
    if row >= len(COACH_MENU_ITEMS):
        return -1
    if (rel - row * COACH_ROW_PITCH) >= COACH_ROW_HEIGHT:
        return -1
    return row


def _draw_menu_row(row, item):
    title, subtitle = _menu_item_display(item)
    y = _coach_row_y(row)
    lcd.rect(0, y, 320, COACH_ROW_HEIGHT, COACH_ROW_BG, COACH_ROW_BG)
    lcd.rect(8, y + 6, 4, COACH_ROW_HEIGHT - 12, ORB_COLOR, ORB_COLOR)
    lcd.font(_COACH_FONT_MED)
    lcd.setCursor(24, y + 4)
    lcd.setColor(PHASE_TEXT_COLOR)
    lcd.print(title[:30])
    lcd.font(_COACH_FONT_SM)
    lcd.setCursor(24, y + 22)
    lcd.setColor(COACH_SUBT_DIM)
    lcd.print(subtitle[:36])


def _draw_coach_menu():
    setScreenColor(COACH_BG)
    # Top bar — title + back hint
    lcd.font(_COACH_FONT_SM)
    lcd.setCursor(8, 10)
    lcd.setColor(PHASE_TEXT_COLOR)
    lcd.print("Coach")
    lcd.setCursor(252, 10)
    lcd.setColor(COACH_TITLE_DIM)
    lcd.print("A back")
    lcd.line(8, 34, 312, 34, 0x1A2A3A)
    # Tagline below the bar
    lcd.setCursor(8, 50)
    lcd.setColor(COACH_TITLE_DIM)
    lcd.print("Tap a row to start")
    # Rows
    for i, item in enumerate(COACH_MENU_ITEMS):
        _draw_menu_row(i, item)


def _flash_row(row):
    y = _coach_row_y(row)
    lcd.rect(0, y, 320, COACH_ROW_HEIGHT, COACH_ROW_FLASH, COACH_ROW_FLASH)
    utime.sleep_ms(100)


# --- Meditation theme picker --------------------------------------------
# Tapping "Meditation" in the coach menu opens this list; tap a theme to
# start it, Btn A backs out. Five compact rows (the coach menu's 3-row
# geometry is too tall for five). session_id maps to the backend themes in
# meditation_agent._THEMES; the device sends it as ?session=<id>.
MEDITATION_THEMES = (
    {"session_id": "calm",     "title": "Calm",          "dur": "3 min"},
    {"session_id": "sleep",    "title": "Sleep",         "dur": "4 min"},
    {"session_id": "focus",    "title": "Focus",         "dur": "3 min"},
    {"session_id": "stress",   "title": "Stress Relief", "dur": "3 min"},
    {"session_id": "energize", "title": "Energize",      "dur": "2 min"},
)
PICK_ROW_TOP    = 42
PICK_ROW_HEIGHT = 34
PICK_ROW_PITCH  = 38


def _pick_row_at(y):
    if y < PICK_ROW_TOP:
        return -1
    rel = y - PICK_ROW_TOP
    row = rel // PICK_ROW_PITCH
    if row >= len(MEDITATION_THEMES):
        return -1
    if (rel - row * PICK_ROW_PITCH) >= PICK_ROW_HEIGHT:
        return -1
    return row


def _draw_meditation_picker():
    setScreenColor(COACH_BG)
    lcd.font(_COACH_FONT_SM)
    lcd.setCursor(8, 10)
    lcd.setColor(PHASE_TEXT_COLOR)
    lcd.print("Meditation")
    lcd.setCursor(252, 10)
    lcd.setColor(COACH_TITLE_DIM)
    lcd.print("A back")
    lcd.line(8, 32, 312, 32, 0x1A2A3A)
    for i, theme in enumerate(MEDITATION_THEMES):
        y = PICK_ROW_TOP + i * PICK_ROW_PITCH
        lcd.rect(0, y, 320, PICK_ROW_HEIGHT, COACH_ROW_BG, COACH_ROW_BG)
        lcd.rect(8, y + 5, 4, PICK_ROW_HEIGHT - 10, ORB_COLOR, ORB_COLOR)
        lcd.font(_COACH_FONT_MED)
        lcd.setCursor(24, y + 8)
        lcd.setColor(PHASE_TEXT_COLOR)
        lcd.print(theme["title"][:20])
        lcd.font(_COACH_FONT_SM)
        lcd.setCursor(258, y + 12)
        lcd.setColor(COACH_SUBT_DIM)
        lcd.print(theme["dur"])


def _run_meditation_picker():
    """Show the theme list. Returns the chosen session_id, or None if Btn A
    was pressed to go back to the coach menu."""
    _draw_meditation_picker()
    _coach_wait_release()
    last_status = False
    while True:
        if btnA.wasPressed():
            return None
        if _HAS_TOUCH:
            try:
                status = _touch.status()
            except Exception:
                status = False
            if status and not last_status:
                try:
                    x, y = _touch.read()
                except Exception:
                    x, y = 0, 0
                if y < 232:
                    row = _pick_row_at(y)
                    if row >= 0:
                        y0 = PICK_ROW_TOP + row * PICK_ROW_PITCH
                        lcd.rect(0, y0, 320, PICK_ROW_HEIGHT, COACH_ROW_FLASH, COACH_ROW_FLASH)
                        utime.sleep_ms(100)
                        return MEDITATION_THEMES[row]["session_id"]
            last_status = status
        utime.sleep_ms(40)
        _coach_feed_wdt()


def _execute_menu_item(row):
    global _speech_busy
    item = COACH_MENU_ITEMS[row]
    kind = item["kind"]
    _speech_busy = True
    try:
        if kind == "ask":
            _run_ask_session()
        elif kind == "breathing":
            tech = COACH_TECHNIQUES[item["tech_idx"]]
            _ensure_coach_voice_assets()
            run_coach_session(tech)
        elif kind == "meditation":
            chosen = _run_meditation_picker()
            if chosen:
                _run_meditation(chosen)
    finally:
        _release_mic()
        _speech_busy = False


def open_coach_menu():
    """Entry point bound to btnC. Loops until Btn A is pressed for back.
    While inside, _speech_busy gates the announcer off the I2S0 bus."""
    global _speech_busy
    _speech_busy = True
    try:
        while True:
            _draw_coach_menu()
            _coach_wait_release()

            last_status = False
            selected   = -1
            while selected < 0:
                if btnA.wasPressed():
                    return
                if _HAS_TOUCH:
                    try:
                        status = _touch.status()
                    except Exception:
                        status = False
                    if status and not last_status:
                        try:
                            x, y = _touch.read()
                        except Exception:
                            x, y = 0, 0
                        if y < 232:
                            row = _coach_row_at(y)
                            if row >= 0:
                                _flash_row(row)
                                selected = row
                                break
                    last_status = status
                utime.sleep_ms(40)
                _coach_feed_wdt()

            _execute_menu_item(selected)
    finally:
        _speech_busy = False
        # Returning to the dashboard — let the main loop redraw it.

# -------------------------------------------------------
# Boot sequence
# -------------------------------------------------------

# 0. Load flash cache — room has memory before any network call
load_last_state()
compute_room_metrics()
debug_room_state_choice()

# 0a. SD mount + diag log — speech features write WAVs to /sd when available,
# /flash otherwise. Diag log accumulates per-boot under /flash/diag.log.
_sd_ok = mount_sd()
_diag_reset()
_diag("boot — SD " + ("ok" if _sd_ok else "missing"))

# 1. WiFi
draw_wifi_menu()
while True:
    if btnA.wasPressed() or btnC.wasPressed():
        if auto_connect_wifi():
            wifi_was_up = True
            send_event("room_online")
            break
        draw_wifi_menu()
    if btnB.wasPressed():
        last_ssid = load_last_wifi()
        draw_text("Last WiFi", last_ssid if last_ssid else "None saved yet", "",
                  0xFFFFFF, 0x00FFCC if last_ssid else 0xFFAA00)
        wait(2); draw_wifi_menu()
    wait_ms(50)

# 2. Draw dashboard with cached state immediately
draw_frame()
init_labels()
update_all()

# 3. NTP — sync clock, then recompute metrics with correct time
try:
    ntp_sync()
    lbl_time.setText(fmt_time())
    lbl_date.setText(fmt_date())
    compute_room_metrics()
    debug_room_state_choice()
    update_readiness_card()
    update_recovery_card()
    update_strain_tile()
    update_climate_tile()
    update_air_tile()
    update_status_line()
    save_last_state()
except: pass

# 4. Cloud sync — overwrite only if cloud data is fresher than cache
try:
    ok, err = sync_from_cloud()
    if ok:
        cloud_sync_state   = "ok"
        network_state      = "online"
        last_cloud_sync_time = utime.time()
        send_event("room_state_restored")
        cloud_norm  = (last_cloud_ts or "")[:19].replace("T", " ")
        cache_norm  = (last_cache_ts or "")[:19]
        if cloud_norm >= cache_norm:
            compute_room_metrics()
            debug_room_state_choice()
            update_all()
            save_last_state()
    else:
        cloud_sync_state = "failed"
        if last_cache_ts:
            data_source = "cache"
        update_header_page1()
except: pass

# 5. Weather — fetch and update hero outdoor info
fetch_outdoor_weather()
update_recovery_card()
save_last_state()

# -------------------------------------------------------
# Main loop
# -------------------------------------------------------
while True:
    now = utime.time()

    # Feed WDT every iteration. The hardware watchdog (armed at boot, 120 s
    # timeout) auto-reboots if a native panic in I2S or speaker code slips
    # past Python-level handling. Speech actions feed it too; this keeps
    # the dashboard alive in long idle stretches.
    if _wdt is not None:
        try: _wdt.feed()
        except Exception: pass

    # A → Dashboard, B → Coach, C → coach menu (Ask / Breathe / Meditation)
    if btnA.wasPressed() and current_page != 1:
        current_page = 1
        draw_frame()
        update_all()

    if btnB.wasPressed() and current_page != 2:
        current_page = 2
        draw_page2_frame()
        update_header_page2()
        update_page2()
    if btnC.wasPressed():
        # Coach menu — Ask / Box Breathing / Meditation. While the menu
        # is open, _speech_busy keeps the proactive announcer off the
        # shared I2S0 bus. On return, redraw whichever page was active —
        # init_labels() must NOT be re-called here (would duplicate the
        # M5TextBox instances created at boot).
        try:
            open_coach_menu()
        except Exception as e:
            print("coach menu error:", e)
        if current_page == 1:
            draw_frame()
            update_all()
        else:
            draw_page2_frame()
            update_header_page2()
            update_page2()

    # Clock update every second
    if current_page == 1:
        lbl_time.setText(fmt_time())
    else:
        lcd.rect(0, 0, 320, 22, P2_HDR, P2_HDR)
        lcd.font(lcd.FONT_DejaVu18)
        lcd.print(fmt_time(), 128, 5, 0xFFFF00)
        lcd.print("COACH", 228, 5, 0x6FE8FF)

    # Sensor read every 60 s
    if (now - last_read_time) >= 60:
        try:
            last_temp     = round(env3.temperature, 1)
            last_humidity = round(env3.humidity, 1)
            last_motion   = pir.state
            last_tvoc     = tvoc.TVOC
            last_eco2     = tvoc.eCO2
            try:
                last_pressure      = round(env3.pressure, 1)
                last_pressure_text = str(int(last_pressure))
            except:
                pass  # keep last known pressure
            data_source = "live"
            last_read_time = now

            # Alerts — fire once when condition appears, reset when it clears
            if last_humidity is not None:
                if last_humidity < HUMIDITY_LOW_THRESHOLD and not humidity_alerted:
                    send_event("humidity_alert", {"value": last_humidity, "threshold": HUMIDITY_LOW_THRESHOLD})
                    humidity_alerted = True
                elif last_humidity >= HUMIDITY_LOW_THRESHOLD:
                    humidity_alerted = False

            if last_tvoc is not None:
                if last_tvoc >= AQ_POOR_THRESHOLD and not aq_alerted:
                    label, _ = aq_status(last_tvoc)
                    send_event("air_quality_alert", {"value": last_tvoc, "label": label})
                    aq_alerted = True
                elif last_tvoc < AQ_POOR_THRESHOLD:
                    aq_alerted = False

            if last_motion == 1 and prev_motion == 0:
                last_motion_trigger_time = now
                send_event("motion_triggered")
                announce_on_motion()  # backend cooldowns rate-limit announcements
            prev_motion = last_motion

            compute_room_metrics()
            debug_room_state_choice()
            print("[metrics] readiness=%s recovery=%s strain=%s state=%s | temp=%s hum=%s tvoc=%s motion_recent=%s evening=%s" % (
                room_readiness, recovery_score, air_strain, room_state,
                last_temp, last_humidity, last_tvoc,
                last_motion_trigger_time is not None and (utime.time() - last_motion_trigger_time) < 300,
                _is_evening()))

        except: pass
        if current_page == 1:
            update_readiness_card()
            update_recovery_card()
            update_strain_tile()
            update_climate_tile()
            update_air_tile()
            update_status_line()
            update_header_page1()
        else:
            update_clock_dot()
            update_page2()
        save_last_state()

        # WiFi drop detection + network_state + silent retry
        try:
            _wlan_up = wifi_connected()
            network_state = "online" if _wlan_up else "offline"
            if wifi_was_up and not _wlan_up:
                wifi_was_up = False
                send_event("wifi_disconnected")
            elif not wifi_was_up and _wlan_up:
                wifi_was_up = True
            if not _wlan_up and (now - last_wifi_retry_time) >= WIFI_RETRY_EVERY:
                last_wifi_retry_time = now
                if silent_reconnect():
                    wifi_was_up = True
                    network_state = "online"
                    if current_page == 1:
                        update_header_page1()
                        update_status_line()
                    else:
                        update_clock_dot()
        except: pass

    # Telemetry every SEND_EVERY s
    if last_temp is not None and (now - last_send_time) >= SEND_EVERY:
        last_send_time = now
        try:
            import urequests, ujson
            payload = {"auth_token": AUTH_TOKEN, "device_id": DEVICE_ID,
                       "indoor_temp": last_temp, "indoor_humidity": last_humidity,
                       "air_quality": last_tvoc, "motion": (last_motion == 1),
                       "indoor_eco2": last_eco2}
            if last_pressure is not None:
                payload["indoor_pressure"] = last_pressure
            rssi = get_wifi_rssi()
            if rssi is not None:
                payload["wifi_rssi"] = rssi
            r = urequests.post(BACKEND_TELEMETRY,
                               headers={"Content-Type": "application/json",
                                        "Authorization": "Bearer " + AUTH_TOKEN},
                               data=ujson.dumps(payload))
            status = r.status_code
            r.close()
            if status in (200, 201):
                telemetry_state     = "idle"
                network_state       = "online"
                last_good_send_time = now
                send_event("room_synced")
            else:
                telemetry_state = "failed"
                send_event("room_sync_failed", {"status": status})
        except Exception as e:
            telemetry_state = "failed"
            network_state   = "offline"
            send_event("room_sync_failed", {"error": str(e)[:60]})
        if current_page == 1:
            update_header_page1()
            update_status_line()
        else:
            update_clock_dot()
            update_page2()

    # Weather refresh every WEATHER_EVERY s
    if (now - last_wx_time) >= WEATHER_EVERY:
        last_wx_time = now
        fetch_outdoor_weather()
        if current_page == 1:
            update_recovery_card()
            update_header_page1()
            update_status_line()
        else:
            update_clock_dot()
            update_page2()
        save_last_state()

    # Proactive announcements — cheap when nothing's due. Polls every 5 min
    # idle, immediately on PIR rising edge, never during quiet hours.
    announce_tick()

    wait(1)
