def _ann_local_hour():
    # ntp_sync() already stores LOCAL time in the RTC (it adds TZ_OFFSET before
    # calling RTC().datetime). fmt_time() and _is_evening() rely on that too —
    # do NOT add TZ_OFFSET again or the announcer will be off by TZ_OFFSET hours.
    return utime.localtime()[3]


def _ann_is_quiet():
    h = _ann_local_hour()
    if ANNOUNCE_QUIET_START <= ANNOUNCE_QUIET_END:
        return ANNOUNCE_QUIET_START <= h < ANNOUNCE_QUIET_END
    return h >= ANNOUNCE_QUIET_START or h < ANNOUNCE_QUIET_END


def _ann_do_poll(force_trigger=None):
    """One-shot proactive poll → play returned WAV. All errors swallowed —
    a backend hiccup or transient WiFi drop must never crash the main loop.
    If force_trigger is set, sends ?force=<trigger_id> so the backend
    bypasses cooldown and condition checks (used by the btnA demo path)."""
    try:
        import urequests
    except Exception as e:
        _diag("[announce] urequests import failed: " + str(e)[:60])
        return

    try:
        url = ANNOUNCE_BACKEND + "?device_id=" + DEVICE_ID + "&raw=1"
        if force_trigger:
            url += "&force=" + force_trigger
        _diag("[announce] GET " + url)
        r = urequests.get(url, headers={"Authorization": "Bearer " + AUTH_TOKEN})
        status = r.status_code
        _diag("[announce] status=" + str(status))

        if status == 204:
            r.close()
            return

        if status != 200:
            r.close()
            return

        try:
            content = r.content
        except Exception as e:
            r.close()
            _diag("[announce] body read failed: " + str(e)[:60])
            return
        r.close()

        try:
            with open(ANNOUNCE_PATH, "wb") as f:
                f.write(content)
        except Exception as e:
            _diag("[announce] write failed: " + str(e)[:60])
            return
        del content
        gc.collect()

        try:
            speaker.playWAV(ANNOUNCE_PATH,
                            rate=ANNOUNCE_WAV_RATE,
                            data_format=speaker.F16B,
                            channel=speaker.CHN_R,
                            volume=ANNOUNCE_VOLUME)
            _diag("[announce] played")
        except Exception as e:
            _diag("[announce] playWAV failed: " + str(e)[:60])

    except Exception as e:
        _diag("[announce] poll error: " + str(e)[:60])


def announce_on_motion():
    """Schedules an immediate poll on the next announce_tick(). Debounced so
    PIR re-fires within 30 s don't all hit the network."""
    global _ann_motion_pending
    _ann_motion_pending = True


def _ann_log_skip(reason):
    """Log a skip reason at most once every 30 s per reason — keeps the
    diag log readable without flooding it."""
    global _ann_last_skip_reason, _ann_last_skip_ts
    now_s = utime.time()
    if reason != _ann_last_skip_reason or (now_s - _ann_last_skip_ts) >= 30:
        _diag("[announce] skip: " + reason)
        _ann_last_skip_reason = reason
        _ann_last_skip_ts     = now_s


def announce_tick():
    """Call from the main loop every iteration. Cheap when nothing's due —
    only issues a network call when the schedule or motion says so, never
    during quiet hours.

    Skipped entirely while a speech action (Ask / Breathing / Meditation)
    is running so the announcer's speaker.playWAV cannot collide with the
    mic record or with our own answer playback on the shared I2S0 bus."""
    global _ann_last_idle_poll, _ann_last_motion_poll, _ann_motion_pending

    if _speech_busy:
        _ann_log_skip("speech_busy")
        return

    if _ann_is_quiet():
        _ann_motion_pending = False
        _ann_log_skip("quiet_hours h=" + str(_ann_local_hour()))
        return

    now_s = utime.time()

    # Continuous-presence re-arm: PIR latches HIGH for several seconds, so a
    # person staying in the room never produces another 0->1 edge. Re-arm the
    # motion poll if PIR is still HIGH and the debounce window has fully
    # elapsed since the last motion poll. Backend cooldowns still rate-limit
    # what gets spoken.
    if (last_motion == 1
            and not _ann_motion_pending
            and (now_s - _ann_last_motion_poll) >= (ANNOUNCE_DEBOUNCE_S * 2)):
        _ann_motion_pending = True

    should_poll = False

    if _ann_motion_pending:
        if (now_s - _ann_last_motion_poll) >= ANNOUNCE_DEBOUNCE_S:
            should_poll          = True
            _ann_last_motion_poll = now_s
            _diag("[announce] motion poll")
        else:
            wait_s = ANNOUNCE_DEBOUNCE_S - (now_s - _ann_last_motion_poll)
            _ann_log_skip("motion debounce wait=" + str(int(wait_s)) + "s")
        _ann_motion_pending = False
    elif (now_s - _ann_last_idle_poll) >= ANNOUNCE_IDLE_POLL_S:
        should_poll = True
        _diag("[announce] idle poll")
    else:
        wait_s = ANNOUNCE_IDLE_POLL_S - (now_s - _ann_last_idle_poll)
        _ann_log_skip("idle wait=" + str(int(wait_s)) + "s")

    if should_poll:
        _ann_last_idle_poll = now_s
        _ann_do_poll()


