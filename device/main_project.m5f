def update_header_page2():
    wlan = network.WLAN(network.STA_IF)
    lbl_dot.setColor(0x00FF66 if wlan.isconnected() else 0xFF4444)
    lbl_date.setText("")
    lbl_time.setText("")
    lbl_source.setText("")
    lcd.rect(0, 0, 320, 22, P2_HDR, P2_HDR)
