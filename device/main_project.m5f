    lbl_date   = M5TextBox(22,  5, "--- -- ---",  lcd.FONT_DejaVu18, 0x888888)
    lbl_source = M5TextBox(160, 5, "LIVE",          lcd.FONT_DejaVu18, 0x00FF66)
    lbl_time   = M5TextBox(245, 5, "--:--",       lcd.FONT_DejaVu18, 0xFFFF00)

    # Hero outdoor: big temp + unit + condition + humidity
    lbl_out_temp = M5TextBox(35,  32, "--.-",    lcd.FONT_DejaVu40, 0xFFFFFF)
    lbl_out_unit = M5TextBox(112, 55, "C",       lcd.FONT_DejaVu18, 0xAAAAAA)
    lbl_msg      = M5TextBox(175, 38, "",         lcd.FONT_DejaVu18, 0x888888)
    lbl_out_cond = M5TextBox(10,  80, "---",     lcd.FONT_DejaVu18, 0x446688)
    lbl_out_hum  = M5TextBox(220, 80, "HUM --%", lcd.FONT_DejaVu18, 0x888888)

    # Indoor strip values
    lbl_in_temp  = M5TextBox(12,  119, "--.- C", lcd.FONT_DejaVu18, 0x00FFCC)
    lbl_in_hum   = M5TextBox(118, 119, "-- %",     lcd.FONT_DejaVu18, 0x66CCFF)
    lbl_in_press = M5TextBox(222, 119, "---- hPa", lcd.FONT_DejaVu18, 0x99CCFF)

    # AQ strip — row 1: chip + ppb value; row 2: eCO2
    lbl_aq_val = M5TextBox(148, 141, "--- ppb",   lcd.FONT_DejaVu18, 0xCCCCCC)
    lbl_eco2   = M5TextBox(10,  161, "CO2 ---",   lcd.FONT_DejaVu18, 0xFFCC99)

    # Forecast 3 columns
    lbl_fc_day  = [M5TextBox(12+i*107, 184, "---",   lcd.FONT_DejaVu18, 0xAAAAAA) for i in range(3)]
    lbl_fc_temp = [M5TextBox(12+i*107, 202, "--/--", lcd.FONT_DejaVu18, 0x88CCFF) for i in range(3)]
    lbl_fc_desc = [M5TextBox(12+i*107, 220, "---",   lcd.FONT_DejaVu18, 0x777777) for i in range(3)]

# -------------------------------------------------------
# Update functions — setText only, no lcd.clear
# -------------------------------------------------------
def source_badge_text_and_color():
    if network_state == "offline":
        return "OFFLINE", 0xFF4444
    if telemetry_state == "failed":
        return "SEND FAIL", 0xFF8800
    if weather_state in ("stale", "failed"):
        if data_source == "live":
            return "LIVE/WX", 0xFFCC00
        return "WX STALE", 0xFFCC00
    if data_source == "cloud":
        return "CLOUD", 0xFFCC00
    if data_source == "cache":
        return "CACHED", 0x888888
    return "LIVE", 0x00FF66

def get_status_message():
    # System alerts — highest priority
    if network_state == "offline":
        return "Offline",        0xFF3333
    if telemetry_state == "failed":
        return "Sync failed",    0xFF7700
    # Room performance — shown when state is computed
    if room_state == "Heavy":
        return "Air strain",     0xFF5500
    if room_state == "Dry":
        return "Dry air",        0xFF8800
    if room_state == "Restless":
        return "Restless",       0xFFAA00
    # Transient system events
    if cloud_sync_state == "ok" and utime.time() - last_cloud_sync_time < 15:
        return "Room synced",    0xFFCC00
    if utime.time() - last_motion_trigger_time < 8:
        return "Motion",         0x00CC55
    if last_good_wx_time > 0 and utime.time() - last_good_wx_time < 30:
        return "Weather fresh",  0x5599BB
    # Room state — positive / idle
    if room_state in ("Fresh", "Sleep-Friendly"):
        return room_state,       0x00CC55
    if room_state == "Calm":
        return "Calm",           0x4488BB
    if room_state == "Social":
        return "Social",         0xAAAA00
    return "", 0x444444

def update_status_line():
    text, color = get_status_message()
    lbl_msg.setText(text)
    lbl_msg.setColor(color)

def update_header():
    wlan = network.WLAN(network.STA_IF)
    lbl_dot.setColor(0x00FF66 if wlan.isconnected() else 0xFF4444)
    lbl_date.setText(fmt_date())
    lbl_time.setText(fmt_time())
    text, color = source_badge_text_and_color()
    lbl_source.setText(text)
    lbl_source.setColor(color)

def update_outdoor():
    if outdoor_temp is not None:
        lbl_out_temp.setText(str(outdoor_temp))
    lbl_out_cond.setText((outdoor_desc or "---")[:20])
    if outdoor_humidity is not None:
        lbl_out_hum.setText("HUM " + str(int(outdoor_humidity)) + "%")

def update_indoor():
    if last_temp is not None:
        lbl_in_temp.setText(str(last_temp) + " C")
    else:
        lbl_in_temp.setText("--.- C")
    if last_humidity is not None:
        lbl_in_hum.setText(str(int(last_humidity)) + " %")
    else:
        lbl_in_hum.setText("-- %")
    lbl_in_press.setText(last_pressure_text + " hPa")

def update_aq():
    status, color = aq_status(last_tvoc)
    # Chip drawn as a filled rect, text printed on top (no label overwrite issues)
    chip_w = max(len(status) * 13 + 10, 50)
    lcd.rect(10, 140, chip_w, 19, color, color)
    lcd.font(lcd.FONT_DejaVu18)
    text_x = 10 + (chip_w - len(status) * 13) // 2
    if text_x < 12: text_x = 12
    lcd.print(status, text_x, 143, 0xFFFFFF)
    lbl_aq_val.setText((str(int(last_tvoc)) if last_tvoc is not None else "---") + " ppb")
    lbl_eco2.setText("CO2 " + (str(int(last_eco2)) if last_eco2 is not None else "---"))

def update_forecast():
    for i in range(3):
        if i < len(forecast):
            f = forecast[i]
            lbl_fc_day[i].setText(f["day"])
            lbl_fc_temp[i].setText(str(f["min"]) + "/" + str(f["max"]))
            lbl_fc_desc[i].setText(f["desc"][:8])
        else:
            lbl_fc_day[i].setText("---")
            
            lbl_fc_temp[i].setText("--/--")
            lbl_fc_desc[i].setText("---")

def update_all():
    try: update_header()
    except: pass
    try: update_outdoor()
    except: pass
    try: update_status_line()
    except: pass
    try: update_indoor()
    except: pass
    try: update_aq()
    except: pass
    try: update_forecast()
    except: pass

# -------------------------------------------------------
# Boot sequence
# -------------------------------------------------------

# 0. Load flash cache (silent — populates state before any network)
load_last_state()

# 1. WiFi
draw_wifi_menu()
while True:
    if btnA.wasPressed() or btnC.wasPressed():
        if auto_connect_wifi():
            send_event("boot_recovered")
            break
        draw_wifi_menu()
    if btnB.wasPressed():
        last_ssid = load_last_wifi()
        draw_text("Last WiFi", last_ssid if last_ssid else "None saved yet", "",
                  0xFFFFFF, 0x00FFCC if last_ssid else 0xFFAA00)
        wait(2); draw_wifi_menu()
    wait_ms(50)

# 2. Draw dashboard with cached state immediately
draw_frame()
init_labels()
update_all()

# 3. NTP — silent, just update clock labels
try:
    ntp_sync()
    lbl_time.setText(fmt_time())
    lbl_date.setText(fmt_date())
except: pass

# 4. Cloud sync — overwrite only if cloud data is fresher than cache
try:
    ok, err = sync_from_cloud()
    if ok:
        cloud_sync_state   = "ok"
        network_state      = "online"
        last_cloud_sync_time = utime.time()
        send_event("cache_loaded")
        cloud_norm  = (last_cloud_ts or "")[:19].replace("T", " ")
        cache_norm  = (last_cache_ts or "")[:19]
        if cloud_norm >= cache_norm:
            update_all()
    else:
        cloud_sync_state = "failed"
        if last_cache_ts:
            data_source = "cache"
        update_header()
except: pass

# 5. Weather — update outdoor section silently
fetch_outdoor_weather()
fetch_forecast()
update_outdoor()
update_forecast()

# -------------------------------------------------------
# Main loop
# -------------------------------------------------------
while True:
    now = utime.time()

    # Clock update every second
    lbl_time.setText(fmt_time())

    # Sensor read every 60 s
    if (now - last_read_time) >= 60:
        try:
            last_temp     = round(env3.temperature, 1)
            last_humidity = round(env3.humidity, 1)
            last_motion   = pir.state
            last_tvoc     = tvoc.TVOC
            last_eco2     = tvoc.eCO2
            try:
                last_pressure      = round(env3.pressure, 1)
                last_pressure_text = str(int(last_pressure))
            except:
                pass  # keep last known pressure
            data_source = "live"
            last_read_time = now

            # Alerts — fire once when condition appears, reset when it clears
            if last_humidity is not None:
                if last_humidity < HUMIDITY_LOW_THRESHOLD and not humidity_alerted:
                    send_event("humidity_alert", {"value": last_humidity, "threshold": HUMIDITY_LOW_THRESHOLD})
                    humidity_alerted = True
                elif last_humidity >= HUMIDITY_LOW_THRESHOLD:
                    humidity_alerted = False

            if last_tvoc is not None:
                if last_tvoc >= AQ_POOR_THRESHOLD and not aq_alerted:
                    label, _ = aq_status(last_tvoc)
                    send_event("air_quality_alert", {"value": last_tvoc, "label": label})
                    aq_alerted = True
                elif last_tvoc < AQ_POOR_THRESHOLD:
                    aq_alerted = False

            if last_motion == 1 and prev_motion == 0:
                last_motion_trigger_time = now
                send_event("motion_triggered")
            prev_motion = last_motion

            compute_room_metrics()

        except: pass
        update_indoor()
        update_aq()
        update_status_line()
        update_header()
        save_last_state()

        # WiFi drop detection + network_state + silent retry
        try:
            _wlan_up = wifi_connected()
            network_state = "online" if _wlan_up else "offline"
            if wifi_was_up and not _wlan_up:
                wifi_was_up = False
                send_event("wifi_disconnected")
            elif not wifi_was_up and _wlan_up:
                wifi_was_up = True
            if not _wlan_up and (now - last_wifi_retry_time) >= WIFI_RETRY_EVERY:
                last_wifi_retry_time = now
                if silent_reconnect():
                    wifi_was_up = True
                    network_state = "online"
        except: pass

    # Telemetry every SEND_EVERY s
    if last_temp is not None and (now - last_send_time) >= SEND_EVERY:
        last_send_time = now
        try:
            import urequests, ujson
            payload = {"auth_token": AUTH_TOKEN, "device_id": DEVICE_ID,
                       "indoor_temp": last_temp, "indoor_humidity": last_humidity,
                       "air_quality": last_tvoc, "motion": (last_motion == 1),
                       "indoor_eco2": last_eco2}
            if last_pressure is not None:
                payload["indoor_pressure"] = last_pressure
            rssi = get_wifi_rssi()
            if rssi is not None:
                payload["wifi_rssi"] = rssi
            r = urequests.post(BACKEND_TELEMETRY,
                               headers={"Content-Type": "application/json",
                                        "Authorization": "Bearer " + AUTH_TOKEN},
                               data=ujson.dumps(payload))
            status = r.status_code
            r.close()
            if status in (200, 201):
                telemetry_state     = "idle"
                network_state       = "online"
                last_good_send_time = now
                send_event("cloud_sync_ok")
            else:
                telemetry_state = "failed"
                send_event("cloud_sync_failed", {"status": status})
        except Exception as e:
            telemetry_state = "failed"
            network_state   = "offline"
            send_event("cloud_sync_failed", {"error": str(e)[:60]})
        update_header()
        update_status_line()

    # Weather refresh every WEATHER_EVERY s
    if (now - last_wx_time) >= WEATHER_EVERY:
        last_wx_time = now
        fetch_outdoor_weather()
        fetch_forecast()
        update_outdoor()
        update_forecast()
        update_header()
        update_status_line()
        save_last_state()

    wait(1)
