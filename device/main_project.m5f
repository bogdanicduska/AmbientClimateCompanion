# -------------------------------------------------------
# WiFi helpers  (unchanged, working)
# -------------------------------------------------------
def draw_text(msg1="", msg2="", msg3="", c1=0xFFFFFF, c2=0xAAAAAA, c3=0x888888):
    lcd.clear(0x0D0D0D)
    lcd.font(lcd.FONT_DejaVu18)
    if msg1: lcd.print(msg1, 10, 50,  c1)
    if msg2: lcd.print(msg2, 10, 90,  c2)
    if msg3: lcd.print(msg3, 10, 130, c3)

def save_last_wifi(ssid):
    try:
        with open(LAST_WIFI_FILE, "w") as f: f.write(ssid)
    except: pass

def load_last_wifi():
    try:
        with open(LAST_WIFI_FILE, "r") as f: return f.read().strip()
    except: return None

def get_wifi_order():
    last = load_last_wifi()
    ordered = [i for i in WIFI_NETWORKS if i[0] == last] if last else []
    for i in WIFI_NETWORKS:
        if i not in ordered: ordered.append(i)
    return ordered

def wait_for_connection(timeout_sec=10):
    wlan = network.WLAN(network.STA_IF)
    start = utime.time()
    while utime.time() - start < timeout_sec:
        if wlan.isconnected(): return True, wlan.ifconfig()[0]
        wait_ms(300)
    return False, None

def try_connect_one(ssid, pwd):
    draw_text("Trying WiFi...", ssid, "Please wait", 0xFFFFFF, 0x00FFCC, 0x888888)
    try:
        import wifiCfg
        wifiCfg.doConnect(ssid, pwd)
    except Exception as e:
        return False, str(e)
    ok, ip = wait_for_connection(10)
    if ok:
        save_last_wifi(ssid)
        send_event("wifi_connected", {"ssid": ssid})
        return True, ip
    return False, "Timeout"

def auto_connect_wifi():
    for ssid, pwd in get_wifi_order():
        ok, result = try_connect_one(ssid, pwd)
        if ok:
            draw_text("Connected!", ssid, "IP: " + result, 0x00FF66, 0x00FFCC, 0x88FF88)
            wait(2)
            return True
        draw_text("Failed", ssid, str(result), 0xFF4444, 0xAAAAAA, 0xFF8888)
        wait(2)
    draw_text("No WiFi connected", "All networks failed", "Check SSID/password", 0xFF4444, 0xAAAAAA, 0xFF8888)
    send_event("wifi_failed")
    return False

def draw_wifi_menu():
    lcd.clear(0x0D0D0D)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("WiFi Auto Connect", 10, 10, 0xFFFFFF)
    lcd.line(0, 34, 320, 34, 0x2A2A2A)
    y = 60
    for ssid, _ in WIFI_NETWORKS:
        lcd.print(ssid, 10, y, 0x00FFCC)
        y += 35
    lcd.print("A: Connect now",    10, 185, 0x666666)
    lcd.print("B: Show last WiFi", 10, 210, 0x666666)
    lcd.print("C: Retry all",      10, 235, 0x666666)

# -------------------------------------------------------
# NTP  (raw socket — working)
# -------------------------------------------------------
def ntp_sync():
    NTP_DELTA = 3155673600
    addr = socket.getaddrinfo("pool.ntp.org", 123)[0][-1]
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(5)
    s.sendto(b'\x1b' + 47 * b'\0', addr)
    msg, _ = s.recvfrom(48)
    s.close()
    t = struct.unpack("!I", msg[40:44])[0] - NTP_DELTA + TZ_OFFSET * 3600
    tm = utime.localtime(t)
    machine.RTC().datetime((tm[0], tm[1], tm[2], tm[6]+1, tm[3], tm[4], tm[5], 0))

def fmt_time():
    t = utime.localtime()
    return "{:02d}:{:02d}".format(t[3], t[4])

def fmt_date():
    t = utime.localtime()
    DAYS   = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"]
    MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
    return "{} {} {}".format(DAYS[t[6]], t[2], MONTHS[t[1]-1])

def fmt_datetime():
    t = utime.localtime()
    return "{:04d}-{:02d}-{:02d} {:02d}:{:02d}:{:02d}".format(
        t[0],t[1],t[2],t[3],t[4],t[5])

# -------------------------------------------------------
# Cloud sync  (working)
# -------------------------------------------------------
def sync_from_cloud():
    global last_temp, last_humidity, last_pressure, last_pressure_text
    global last_tvoc, last_eco2, last_motion, outdoor_temp, outdoor_desc
    global outdoor_humidity, data_source, last_cloud_ts
    import urequests, ujson
    r = urequests.get(BACKEND_BASE_URL + "/latest?device_id=" + DEVICE_ID)
    status = r.status_code
    raw = r.text
    r.close()
    if status == 404:
        return True, None
    resp = ujson.loads(raw)
    if not resp.get("success"):
        return False, "API returned success=false"
    d = resp["data"]
    if d.get("indoor_temp")      is not None: last_temp     = d["indoor_temp"]
    if d.get("indoor_humidity")  is not None: last_humidity = d["indoor_humidity"]
    if d.get("indoor_pressure")  is not None:
        last_pressure = d["indoor_pressure"]
        last_pressure_text = str(int(last_pressure))
    if d.get("air_quality")      is not None: last_tvoc   = d["air_quality"]
    if d.get("indoor_eco2")      is not None: last_eco2   = d["indoor_eco2"]
    if d.get("motion")           is not None: last_motion = 1 if d["motion"] else 0
    if d.get("outdoor_temp")     is not None: outdoor_temp = d["outdoor_temp"]
    if d.get("outdoor_humidity") is not None: outdoor_humidity = d["outdoor_humidity"]
    if d.get("outdoor_weather")  is not None: outdoor_desc = d["outdoor_weather"]
    if d.get("timestamp")        is not None: last_cloud_ts = str(d["timestamp"])
    data_source = "cloud"
    return True, None

# -------------------------------------------------------
# Flash state cache
# -------------------------------------------------------
def save_last_state():
    try:
        import ujson
        state = {
            "temp": last_temp, "humidity": last_humidity,
            "pressure": last_pressure, "tvoc": last_tvoc,
            "eco2": last_eco2, "motion": bool(last_motion),
            "outdoor_temp": outdoor_temp, "outdoor_desc": outdoor_desc,
            "outdoor_humidity": outdoor_humidity,
            "timestamp": fmt_datetime(), "data_source": data_source,
            "room_readiness": room_readiness,
            "recovery_score": recovery_score,
            "air_strain": air_strain,
            "room_state": room_state,
        }
        with open(LAST_STATE_FILE, "w") as f:
            f.write(ujson.dumps(state))
    except: pass

def load_last_state():
    global last_temp, last_humidity, last_pressure, last_pressure_text
    global last_tvoc, last_eco2, last_motion, outdoor_temp, outdoor_desc
    global outdoor_humidity, data_source, last_cache_ts
    global room_readiness, recovery_score, air_strain, room_state
    try:
        import ujson
        with open(LAST_STATE_FILE, "r") as f:
            s = ujson.loads(f.read())
        if s.get("temp")             is not None: last_temp          = s["temp"]
        if s.get("humidity")         is not None: last_humidity      = s["humidity"]
        if s.get("pressure")         is not None:
            last_pressure      = s["pressure"]
            last_pressure_text = str(int(s["pressure"]))
        if s.get("tvoc")             is not None: last_tvoc          = s["tvoc"]
        if s.get("eco2")             is not None: last_eco2          = s["eco2"]
        if s.get("motion")           is not None: last_motion        = 1 if s["motion"] else 0
        if s.get("outdoor_temp")     is not None: outdoor_temp       = s["outdoor_temp"]
        if s.get("outdoor_desc")     is not None: outdoor_desc       = s["outdoor_desc"]
        if s.get("outdoor_humidity") is not None: outdoor_humidity   = s["outdoor_humidity"]
        if s.get("room_readiness")   is not None: room_readiness     = s["room_readiness"]
        if s.get("recovery_score")   is not None: recovery_score     = s["recovery_score"]
        if s.get("air_strain")       is not None: air_strain         = s["air_strain"]
        if s.get("room_state")       is not None: room_state         = s["room_state"]
        last_cache_ts = s.get("timestamp")
        data_source = "cache"
        return last_cache_ts
    except:
        return None

