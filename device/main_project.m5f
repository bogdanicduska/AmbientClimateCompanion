    lcd.print("RCV " + v_val, 125, 159, 0xFFFFFF)
    lcd.print("AIR " + s_val, 230, 159, 0xFFFFFF)

    # NEXT card  y=187..234
    lcd.rect(6, 187, 308, 47, P2_NEXT, P2_NEXT)
    lcd.print("NEXT", 14, 192, 0x4A7AA8)
    if footer:
        lcd.print(footer, 14, 210, 0xFFFFFF)
