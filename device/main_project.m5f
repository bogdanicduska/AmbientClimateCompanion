# -------------------------------------------------------
# UI helpers
# -------------------------------------------------------
def source_badge_text_and_color():
    if network_state == "offline":
        return "OFFLN",   0xFF4444
    if telemetry_state == "failed":
        return "TX ERR",  0xFF8800
    if weather_state in ("stale", "failed"):
        if data_source == "live":
            return "WX STL", 0xFFCC00
        return "WX OLD",  0xFFCC00
    if data_source == "cloud":
        return "CLOUD",     0xFFCC00
    if data_source == "cache":
        return "CACHE",     0x888888
    return "LIVE", 0x00FF66

def room_state_color():
    colors = {
        "Fresh":         0x006633,
        "Calm":          0x224466,
        "Dry":           0x885500,
        "Heavy":         0xAA2200,
        "Social":        0x555500,
        "Sleep-Friendly":0x223355,
        "Restless":      0x884400,
    }
    return colors.get(room_state, 0x333333)

def readiness_color(score):
    if score is None:  return 0x555555
    if score >= 75:    return 0x00CC55
    if score >= 50:    return 0xFFCC00
    return 0xFF5500

def recovery_level_label(score):
    if score is None:  return "---",    0x555555
    if score >= 75:    return "Good",   0x00CC55
    if score >= 50:    return "Fair",   0xFFCC00
    return "Low",   0xFF7700

def strain_level_label(score):
    if score is None:  return "---",     0x555555
    if score < 30:     return "Low",     0x00CC55
    if score < 60:     return "Rising",  0xFFAA00
    return "High",  0xFF3300

def strain_color(score):
    if score is None:  return 0x555555
    if score < 30:     return 0x00CC55
    if score < 60:     return 0xFFAA00
    return 0xFF3300

def rhythm_label():
    now = utime.time()
    if now - last_motion_trigger_time < 120:
        return "Active", 0x00CC55
    if last_motion == 1:
        return "Present", 0x88AA00
    return "Quiet", 0x444444

def get_room_insight():
    if network_state == "offline":
        return "Offline. Showing cached data.", 0xFF4444
    if telemetry_state == "failed":
        return "Sync failed. Data may be stale.", 0xFF7700
    if room_state == "Heavy":
        return "Air heavy. Try ventilating.", 0xFF5500
    if room_state == "Dry":
        return "Dry air. Humidity is low.", 0xFF8800
    if room_state == "Restless":
        return "Room conditions unbalanced.", 0xFFAA00
    if room_state == "Sleep-Friendly":
        return "Sleep-friendly. Rest well.", 0x5599BB
    if room_state == "Fresh":
        return "Room is fresh and ready.", 0x00CC55
    if room_state == "Social":
        return "Room active. Strain may rise.", 0xAAAA00
    if room_state == "Calm":
        return "Calm. Recovery conditions good.", 0x4488BB
    return "Monitoring room conditions.", 0x444444

# -------------------------------------------------------
# Weather icon — drawn with lcd primitives at (x, y), 30x30px
# -------------------------------------------------------
def draw_weather_icon(x, y):
    desc = (outdoor_desc or "").lower()
    lcd.rect(x, y, 30, 30, CARD_TEAL, CARD_TEAL)
    if "rain" in desc or "drizzle" in desc or "shower" in desc:
        lcd.circle(x+8,  y+11, 6, 0x8899BB, 0x8899BB)
        lcd.circle(x+15, y+7,  8, 0xAABBDD, 0xAABBDD)
        lcd.circle(x+22, y+11, 6, 0x8899BB, 0x8899BB)
        lcd.rect(x+4, y+13, 22, 6, 0x99AACC, 0x99AACC)
        lcd.rect(x+6,  y+22, 2, 6, 0x4488FF, 0x4488FF)
        lcd.rect(x+14, y+22, 2, 6, 0x4488FF, 0x4488FF)
        lcd.rect(x+22, y+22, 2, 6, 0x4488FF, 0x4488FF)
    elif "cloud" in desc or "overcast" in desc:
        lcd.circle(x+7,  y+14, 7, 0x777777, 0x777777)
        lcd.circle(x+15, y+10, 9, 0xCCCCCC, 0xCCCCCC)
        lcd.circle(x+23, y+14, 7, 0x777777, 0x777777)
        lcd.rect(x+3, y+16, 24, 7, 0xAAAAAA, 0xAAAAAA)
    elif "snow" in desc:
        lcd.circle(x+15, y+15, 10, 0xDDEEFF, 0xDDEEFF)
        lcd.circle(x+15, y+15,  6, 0xEEFFFF, 0xEEFFFF)
    else:
        lcd.circle(x+15, y+15, 10, 0xFFDD33, 0xFFDD33)
        lcd.rect(x+14, y+2,  2, 4, 0xFFCC00, 0xFFCC00)
        lcd.rect(x+14, y+24, 2, 4, 0xFFCC00, 0xFFCC00)
        lcd.rect(x+2,  y+14, 4, 2, 0xFFCC00, 0xFFCC00)
        lcd.rect(x+24, y+14, 4, 2, 0xFFCC00, 0xFFCC00)

# -------------------------------------------------------
# Update functions — lcd.rect clear + lcd.print, no M5TextBox
# -------------------------------------------------------
def update_header():
    wlan = network.WLAN(network.STA_IF)
    lbl_dot.setColor(0x00FF66 if wlan.isconnected() else 0xFF4444)
    lbl_date.setText(fmt_date())
    lbl_time.setText(fmt_time())
    text, color = source_badge_text_and_color()
    lbl_source.setText(text)
    lbl_source.setColor(color)

def update_hero():
    lcd.font(lcd.FONT_DejaVu18)

    # --- Readiness card (x=0..199, y=23..107) ---
    score_r = room_readiness if room_readiness is not None else 0
    r_color = readiness_color(room_readiness)
    # Clear score area (from y=48 to avoid clipping "READINESS" label at y=26..44)
    lcd.rect(4, 48, 192, 40, CARD_BLUE, CARD_BLUE)
    # Redraw static label (in case border was touched)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("READINESS", 8, 26, 0x1E4A7A)
    lcd.font(lcd.FONT_DejaVu40)
    lcd.print(str(score_r) if room_readiness is not None else "--", 8, 48, r_color)
    # State chip — below score
    chip_label = room_state if room_state else "---"
    chip_w = max(min(len(chip_label) * 13 + 10, 188), 40)
    chip_c = room_state_color()
    lcd.rect(4, 90, 192, 18, CARD_BLUE, CARD_BLUE)
    lcd.rect(6, 90, chip_w, 16, chip_c, chip_c)
    lcd.font(lcd.FONT_DejaVu18)
    tx = 6 + max((chip_w - len(chip_label) * 13) // 2, 2)
    lcd.print(chip_label.upper(), tx, 91, 0xFFFFFF)

    # --- Recovery card (x=201..319, y=23..107) ---
    score_v = recovery_score if recovery_score is not None else 0
    level_text, level_color = recovery_level_label(recovery_score)
    lcd.rect(203, 44, 112, 22, CARD_TEAL, CARD_TEAL)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("RECOVERY", 205, 26, 0x1A5048)
    lcd.print(str(score_v) if recovery_score is not None else "--", 205, 46, 0x66CCFF)
    lcd.rect(203, 66, 112, 22, CARD_TEAL, CARD_TEAL)
    lcd.print(level_text, 205, 68, level_color)
    lcd.rect(203, 86, 72, 20, CARD_TEAL, CARD_TEAL)
    out_text = (str(outdoor_temp) + " C") if outdoor_temp is not None else "--"
    lcd.print(out_text, 205, 88, 0x558888)
    draw_weather_icon(284, 62)

def update_tiles():
    lcd.font(lcd.FONT_DejaVu18)

    # --- Strain card (x=0..119, y=109..177) — 120px wide ---
    lcd.rect(0, 130, 118, 22, CARD_STRAIN, CARD_STRAIN)
    lcd.print(str(air_strain) if air_strain is not None else "--", 5, 132, strain_color(air_strain))
    level_text, level_color = strain_level_label(air_strain)
    lcd.rect(0, 154, 118, 22, CARD_STRAIN, CARD_STRAIN)
    lcd.print(level_text, 5, 156, level_color)

    # --- Climate card (x=121..199, y=109..177) ---
    lcd.rect(122, 109, 76, 22, CARD_CLIM, CARD_CLIM)
    lcd.print((str(last_temp) + " C") if last_temp is not None else "-- C", 126, 111, 0x00FFCC)
    lcd.rect(122, 132, 76, 22, CARD_CLIM, CARD_CLIM)
    lcd.print((str(int(last_humidity)) + " %") if last_humidity is not None else "-- %", 126, 134, 0x66CCFF)
    lcd.rect(122, 154, 76, 22, CARD_CLIM, CARD_CLIM)
    lcd.print(last_pressure_text + " hPa", 126, 156, 0x667788)

    # --- AQ card (x=201..319, y=109..177) ---
    lcd.rect(202, 109, 116, 22, CARD_AQ, CARD_AQ)
    lcd.print("TVOC " + (str(int(last_tvoc)) if last_tvoc is not None else "---"), 206, 111, 0xCCCCCC)
    lcd.rect(202, 132, 116, 22, CARD_AQ, CARD_AQ)
    lcd.print("CO2 " + (str(int(last_eco2)) if last_eco2 is not None else "---"), 206, 134, 0xFFCC99)
    r_text, r_color = rhythm_label()
    lcd.rect(202, 154, 116, 22, CARD_AQ, CARD_AQ)
    lcd.print(r_text, 206, 156, r_color)

def update_insight():
    text, color = get_room_insight()
    lcd.rect(0, 180, 320, 42, BG, BG)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print(text, 10, 186, color)

def update_all():
    try: update_header()
    except: pass
    try: update_hero()
    except: pass
    try: update_tiles()
    except: pass
    try: update_insight()
    except: pass

# -------------------------------------------------------
# Boot sequence
# -------------------------------------------------------

# 0. Load flash cache — room has memory before any network call
load_last_state()
compute_room_metrics()

# 1. WiFi
draw_wifi_menu()
while True:
    if btnA.wasPressed() or btnC.wasPressed():
        if auto_connect_wifi():
            send_event("room_online")
            break
        draw_wifi_menu()
    if btnB.wasPressed():
        last_ssid = load_last_wifi()
        draw_text("Last WiFi", last_ssid if last_ssid else "None saved yet", "",
                  0xFFFFFF, 0x00FFCC if last_ssid else 0xFFAA00)
        wait(2); draw_wifi_menu()
    wait_ms(50)

# 2. Draw dashboard with cached state immediately
draw_frame()
init_labels()
update_all()

# 3. NTP — silent, just update clock labels
try:
    ntp_sync()
    lbl_time.setText(fmt_time())
    lbl_date.setText(fmt_date())
except: pass

# 4. Cloud sync — overwrite only if cloud data is fresher than cache
try:
    ok, err = sync_from_cloud()
    if ok:
        cloud_sync_state   = "ok"
        network_state      = "online"
        last_cloud_sync_time = utime.time()
        send_event("room_state_restored")
        cloud_norm  = (last_cloud_ts or "")[:19].replace("T", " ")
        cache_norm  = (last_cache_ts or "")[:19]
        if cloud_norm >= cache_norm:
            update_all()
            save_last_state()
    else:
        cloud_sync_state = "failed"
        if last_cache_ts:
            data_source = "cache"
        update_header()
except: pass

# 5. Weather — fetch and update hero outdoor info
fetch_outdoor_weather()
update_hero()
save_last_state()

# -------------------------------------------------------
# Main loop
# -------------------------------------------------------
while True:
    now = utime.time()

    # Clock update every second
    lbl_time.setText(fmt_time())

    # Sensor read every 60 s
    if (now - last_read_time) >= 60:
        try:
            last_temp     = round(env3.temperature, 1)
            last_humidity = round(env3.humidity, 1)
            last_motion   = pir.state
            last_tvoc     = tvoc.TVOC
            last_eco2     = tvoc.eCO2
            try:
                last_pressure      = round(env3.pressure, 1)
                last_pressure_text = str(int(last_pressure))
            except:
                pass  # keep last known pressure
            data_source = "live"
            last_read_time = now

            # Alerts — fire once when condition appears, reset when it clears
            if last_humidity is not None:
                if last_humidity < HUMIDITY_LOW_THRESHOLD and not humidity_alerted:
                    send_event("humidity_alert", {"value": last_humidity, "threshold": HUMIDITY_LOW_THRESHOLD})
                    humidity_alerted = True
                elif last_humidity >= HUMIDITY_LOW_THRESHOLD:
                    humidity_alerted = False

            if last_tvoc is not None:
                if last_tvoc >= AQ_POOR_THRESHOLD and not aq_alerted:
                    label, _ = aq_status(last_tvoc)
                    send_event("air_quality_alert", {"value": last_tvoc, "label": label})
                    aq_alerted = True
                elif last_tvoc < AQ_POOR_THRESHOLD:
                    aq_alerted = False

            if last_motion == 1 and prev_motion == 0:
                last_motion_trigger_time = now
                send_event("motion_triggered")
            prev_motion = last_motion

            compute_room_metrics()

        except: pass
        update_hero()
        update_tiles()
        update_insight()
        update_header()
        save_last_state()

        # WiFi drop detection + network_state + silent retry
        try:
            _wlan_up = wifi_connected()
            network_state = "online" if _wlan_up else "offline"
            if wifi_was_up and not _wlan_up:
                wifi_was_up = False
                send_event("wifi_disconnected")
            elif not wifi_was_up and _wlan_up:
                wifi_was_up = True
            if not _wlan_up and (now - last_wifi_retry_time) >= WIFI_RETRY_EVERY:
                last_wifi_retry_time = now
                if silent_reconnect():
                    wifi_was_up = True
                    network_state = "online"
        except: pass

    # Telemetry every SEND_EVERY s
    if last_temp is not None and (now - last_send_time) >= SEND_EVERY:
        last_send_time = now
        try:
            import urequests, ujson
            payload = {"auth_token": AUTH_TOKEN, "device_id": DEVICE_ID,
                       "indoor_temp": last_temp, "indoor_humidity": last_humidity,
                       "air_quality": last_tvoc, "motion": (last_motion == 1),
                       "indoor_eco2": last_eco2}
            if last_pressure is not None:
                payload["indoor_pressure"] = last_pressure
            rssi = get_wifi_rssi()
            if rssi is not None:
                payload["wifi_rssi"] = rssi
            r = urequests.post(BACKEND_TELEMETRY,
                               headers={"Content-Type": "application/json",
                                        "Authorization": "Bearer " + AUTH_TOKEN},
                               data=ujson.dumps(payload))
            status = r.status_code
            r.close()
            if status in (200, 201):
                telemetry_state     = "idle"
                network_state       = "online"
                last_good_send_time = now
                send_event("room_synced")
            else:
                telemetry_state = "failed"
                send_event("room_sync_failed", {"status": status})
        except Exception as e:
            telemetry_state = "failed"
            network_state   = "offline"
            send_event("room_sync_failed", {"error": str(e)[:60]})
        update_header()
        update_insight()

    # Weather refresh every WEATHER_EVERY s
    if (now - last_wx_time) >= WEATHER_EVERY:
        last_wx_time = now
        fetch_outdoor_weather()
        update_hero()
        update_header()
        update_insight()
        save_last_state()

    wait(1)
