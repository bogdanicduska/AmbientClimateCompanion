def wifi_connected():
    try:
        return network.WLAN(network.STA_IF).isconnected()
    except:
        return False

def silent_reconnect():
    try:
        import wifiCfg
        ssid, pwd = get_wifi_order()[0]
        wifiCfg.doConnect(ssid, pwd)
        ok, _ = wait_for_connection(8)
        if ok:
            save_last_wifi(ssid)
        return ok
    except:
        return False

def get_wifi_rssi():
    try:
        return network.WLAN(network.STA_IF).status("rssi")
    except:
        return None

def send_event(event_type, details=None):
    try:
        import urequests, ujson
        payload = {"device_id": DEVICE_ID, "event_type": event_type}
        if details is not None:
            payload["details"] = details
        r = urequests.post(BACKEND_EVENTS,
                           headers={"Content-Type": "application/json",
                                    "Authorization": "Bearer " + AUTH_TOKEN},
                           data=ujson.dumps(payload))
        r.close()
    except: pass

# -------------------------------------------------------
# Weather / forecast  (working)
# -------------------------------------------------------
def fetch_outdoor_weather():
    global outdoor_temp, outdoor_desc, outdoor_humidity, weather_state, last_good_wx_time
    try:
        import urequests, ujson
        r = urequests.get("https://api.openweathermap.org/data/2.5/weather?q=" +
                          OWM_CITY + "&appid=" + OWM_API_KEY + "&units=metric")
        raw = r.text; r.close()
        d = ujson.loads(raw)
        outdoor_temp     = round(d["main"]["temp"], 1)
        outdoor_desc     = d["weather"][0]["description"]
        outdoor_humidity = d["main"]["humidity"]
        weather_state    = "fresh"
        last_good_wx_time = utime.time()
    except:
        if outdoor_temp is not None:
            weather_state = "stale"
        else:
            weather_state = "failed"

def fetch_forecast():
    global forecast
    try:
        import urequests, ujson
        r = urequests.get("https://api.openweathermap.org/data/2.5/forecast?q=" +
                          OWM_CITY + "&appid=" + OWM_API_KEY + "&units=metric&cnt=40")
        raw = r.text; r.close()
        d = ujson.loads(raw)
        today_t   = utime.localtime()
        today_str = "{:04d}-{:02d}-{:02d}".format(today_t[0], today_t[1], today_t[2])
        days = {}
        for item in d["list"]:
            date = item["dt_txt"][:10]
            if date == today_str: continue
            temp = item["main"]["temp"]
            desc = item["weather"][0]["main"]
            if date not in days:
                days[date] = {"min": temp, "max": temp, "desc": desc}
            else:
                if temp < days[date]["min"]: days[date]["min"] = temp
                if temp > days[date]["max"]: days[date]["max"] = temp
        forecast = []
        for date in sorted(days.keys())[:3]:
            dd = days[date]
            DAYS2 = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"]
            try:
                import utime as _t
                parts = date.split("-")
                wday  = _t.localtime(_t.mktime((int(parts[0]),int(parts[1]),int(parts[2]),0,0,0,0,0)))[6]
                dname = DAYS2[wday]
            except:
                dname = date[5:]
            forecast.append({"day": dname, "min": round(dd["min"],1),
                              "max": round(dd["max"],1), "desc": dd["desc"][:7]})
    except: pass

# -------------------------------------------------------
# Room performance metrics
#
# Room Readiness:  how supportive the room is for active use, focus,
#                  and comfortable presence. (0-100)
# Recovery Score:  how supportive the room is for calm, rest, and
#                  recovery-like conditions. (0-100)
# Air Strain:      how heavy, stale, or environmentally stressed the
#                  room feels. (0-100)
# Room State:      human-readable label summarising the room's current
#                  condition (Fresh / Calm / Dry / Heavy / Social /
#                  Sleep-Friendly / Restless).
# -------------------------------------------------------
def _score_temp_readiness(t):
    if t is None: return 50
    if 20 <= t <= 24: return 100
    if 18 <= t < 20 or 24 < t <= 26: return 60
    return 20

def _score_humidity_readiness(h):
    if h is None: return 50
    if 40 <= h <= 60: return 100
    if 35 <= h < 40 or 60 < h <= 65: return 60
    return 20

def _score_tvoc_readiness(v):
    if v is None: return 50
    if v < 100: return 100
    if v < 150: return 65
    if v < 200: return 35
    return 5

def _score_temp_recovery(t):
    if t is None: return 50
    if 18 <= t <= 22: return 100
    if 16 <= t < 18 or 22 < t <= 24: return 60
    return 20

def _score_humidity_recovery(h):
    if h is None: return 50
    if 45 <= h <= 65: return 100
    if 40 <= h < 45 or 65 < h <= 70: return 65
    if h < 40: return 20
    return 40

def _score_tvoc_recovery(v):
    if v is None: return 50
    if v < 100: return 100
    if v < 150: return 60
    if v < 200: return 25
    return 0

def _compute_air_strain(tvoc, eco2, temp, motion_recent):
    if tvoc is None: return 0
    if tvoc >= 200:   base = 85
    elif tvoc >= 150: base = 65
    elif tvoc >= 100: base = 40
    else:             base = 10
    if eco2 is not None and eco2 > 1000: base = min(100, base + 10)
    if temp is not None and temp > 25 and base > 30: base = min(100, base + 8)
    if motion_recent: base = min(100, base + 7)
    return base

def _is_evening():
    h = utime.localtime()[3]
    return h >= 20 or h < 7

def compute_room_metrics():
    global room_readiness, recovery_score, air_strain, room_state

    if last_tvoc is None or last_temp is None or last_humidity is None:
        room_state = "---"
        return

    motion_recent = last_motion_trigger_time is not None and (utime.time() - last_motion_trigger_time) < 300

    # Room readiness (temp 35%, humidity 30%, TVOC 35%)
    r = (_score_temp_readiness(last_temp)     * 35 +
         _score_humidity_readiness(last_humidity) * 30 +
         _score_tvoc_readiness(last_tvoc)     * 35) // 100
    room_readiness = max(0, min(100, r))

    # Recovery score (temp 30%, humidity 25%, TVOC 40%, evening bonus, motion penalty)
    v = (_score_temp_recovery(last_temp)     * 30 +
         _score_humidity_recovery(last_humidity) * 25 +
         _score_tvoc_recovery(last_tvoc)     * 40) // 95
    if _is_evening() and last_tvoc < 100 and not motion_recent:
        v = min(100, v + 8)
    if motion_recent:
        v = max(0, v - 10)
    if last_motion == 1:
        v = max(0, v - 5)
    recovery_score = max(0, min(100, v))

    # Air strain
    air_strain = _compute_air_strain(last_tvoc, last_eco2, last_temp, motion_recent)

    # Room state (priority: Dry → Heavy → Social → Sleep-Friendly → Calm → Fresh)
    if last_humidity < HUMIDITY_LOW_THRESHOLD:
        room_state = "Dry"
    elif last_tvoc >= AQ_POOR_THRESHOLD or air_strain >= 65:
        room_state = "Heavy"
    elif motion_recent or last_motion == 1:
        room_state = "Social"
    elif _is_evening() and recovery_score >= 65:
        room_state = "Sleep-Friendly"
    elif recovery_score >= 70:
        room_state = "Calm"
    elif room_readiness >= 70:
        room_state = "Fresh"
    else:
        room_state = "Restless"

# -------------------------------------------------------
# AQ helpers
# -------------------------------------------------------
def aq_status(tvoc_val):
    if tvoc_val is None:               return "N/A",       0x444444
    if tvoc_val < 100:                 return "GOOD",      0x006633
    if tvoc_val < AQ_POOR_THRESHOLD:   return "MODERATE",  0x886600
    if tvoc_val < AQ_HAZARD_THRESHOLD: return "POOR",      0xAA4400
    return "HAZARDOUS", 0xAA0000

def aq_display_label(tvoc_val):
    if tvoc_val is None:               return "N/A",  0x444444
    if tvoc_val < 100:                 return "GOOD", 0x006633
    if tvoc_val < AQ_POOR_THRESHOLD:   return "MOD",  0x886600
    if tvoc_val < AQ_HAZARD_THRESHOLD: return "POOR", 0xAA4400
    return "HAZ", 0xAA0000

# -------------------------------------------------------
# UI  —  WHOOP-for-Room dashboard layout
# -------------------------------------------------------
#
#  320 x 240
#  ┌─────────────────────────────────────────┐  y=0
#  │  ● Thu 23 Apr  15:11             LIVE  │  y=0-22   header
#  ├──────────────────────┬──────────────────┤  y=23
#  │  READINESS           │  RECOVERY        │  y=24-107 hero
#  │       82             │    76            │
#  │  [  FRESH  ]         │    Good          │
#  │                      │    Out: 9.3 C    │
#  ├──────┬───────────────┴──────┬───────────┤  y=108
#  │STRAIN│ 22.4 C               │ TVOC 118  │  y=109-177 tiles
#  │  31  │  48 %                │ CO2  540  │
#  │ Low  │ 1026 hPa             │ Active    │
#  ├──────┴──────────────────────┴───────────┤  y=178
#  │  Room is fresh and ready.               │  y=179-239 insight
#  │                         ROOM RHYTHM     │
#  └─────────────────────────────────────────┘

BG           = 0x080C10
CARD_BLUE    = 0x0E2840   # readiness hero
CARD_TEAL    = 0x0A2220   # recovery hero
CARD_STRAIN  = 0x1C1028   # strain tile
CARD_CLIM    = 0x0D1A22   # climate tile
CARD_AQ      = 0x0C1C12   # AQ tile
P2_BG    = 0x0B1220   # page 2 background
P2_HDR   = 0x111A2A   # header bar
P2_HERO  = 0x1C3460   # hero card  — brightest layer
P2_WHY   = 0x101E30   # why card   — mid layer
P2_NEXT  = 0x0C1420   # next card  — darkest layer
P2_CHIP_READY = 0xD4A91F
P2_CHIP_RECOV = 0x3CAEDB

def draw_frame():
    lcd.clear(BG)
    # Hero cards (1px BG gap acts as divider)
    lcd.rect(0,   23, 200,  85, CARD_BLUE,   CARD_BLUE)
    lcd.rect(201, 23, 119,  85, CARD_TEAL,   CARD_TEAL)
    # Tile cards  (strain 120px, climate 79px, AQ 119px)
    lcd.rect(0,   109, 120, 69, CARD_STRAIN, CARD_STRAIN)
    lcd.rect(121, 109,  79, 69, CARD_CLIM,   CARD_CLIM)
    lcd.rect(201, 109, 119, 69, CARD_AQ,     CARD_AQ)
    # Static section labels
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("READINESS", 8,  26, 0x1E4A7A)
    lcd.print("STRAIN",    5, 111, 0x4A3070)
    # Watermark
    lcd.print("ROOM RHYTHM", 175, 224, 0x1A1A1A)

# Header labels (M5TextBox — sit on BG, safe to update)
lbl_dot = lbl_date = lbl_time = lbl_source = None

def init_labels():
    global lbl_dot, lbl_date, lbl_time, lbl_source
    lbl_dot    = M5TextBox(6,   5, "*",          lcd.FONT_DejaVu18, 0x00FF66)
    lbl_date   = M5TextBox(22,  5, "--- -- ---", lcd.FONT_DejaVu18, 0x888888)
    lbl_source = M5TextBox(222, 5, "LIVE",        lcd.FONT_DejaVu18, 0x00FF66)
    lbl_time   = M5TextBox(148, 5, "--:--",      lcd.FONT_DejaVu18, 0xFFFF00)

# -------------------------------------------------------
# UI helpers
# -------------------------------------------------------
def source_badge_text_and_color():
    if network_state == "offline":
        return "OFFLN",   0xFF4444
    if telemetry_state == "failed":
        return "TX ERR",  0xFF8800
    if weather_state in ("stale", "failed"):
        if data_source == "live":
            return "WX STL", 0xFFCC00
        return "WX OLD",  0xFFCC00
    if data_source == "cloud":
        return "CLOUD",     0xFFCC00
    if data_source == "cache":
        return "CACHE",     0x888888
    return "LIVE", 0x00FF66

def room_state_color():
    colors = {
        "Fresh":         0x0A5C2A,
        "Calm":          0x1E3D5C,
        "Dry":           0x7A5A00,
        "Heavy":         0xAA2200,
        "Social":        0x6B6600,
        "Sleep-Friendly":0x1A304A,
        "Restless":      0x884400,
    }
    return colors.get(room_state, 0x333333)

def readiness_color(score):
    if score is None:  return 0x555555
    if score >= 75:    return 0x00CC55
    if score >= 50:    return 0xFFCC00
    return 0xFF5500

def recovery_level_label(score):
    if score is None:  return "---",    0x555555
    if score >= 75:    return "Good",   0x00BBCC
    if score >= 50:    return "Fair",   0xFFCC00
    return "Low",   0xFF7700

def strain_level_label(score):
    if score is None:  return "---",     0x555555
    if score < 30:     return "Low",     0x00CC55
    if score < 60:     return "Rising",  0xFFAA00
    return "High",  0xFF3300

def strain_color(score):
    if score is None:  return 0x555555
    if score < 30:     return 0x00CC55
    if score < 60:     return 0xFFAA00
    return 0xFF3300

def rhythm_label():
    now = utime.time()
    if last_motion_trigger_time is not None and now - last_motion_trigger_time < 300:
        return "Active", 0x00CC55
    if last_motion == 1:
        return "Present", 0x88AA00
    return "Quiet", 0x444444

def get_status_message():
    now = utime.time()
    # 1. Offline
    if network_state == "offline":
        return "Offline. Showing last known values.", 0xFF4444
    # 2. Sync failed
    if telemetry_state == "failed":
        return "Sync failed. Data may be stale.", 0xFF7700
    # 3. Weather stale
    if weather_state in ("stale", "failed"):
        return "Weather data outdated.", 0xFFAA00
    # 4. Air strain rising
    if air_strain is not None and air_strain >= 60:
        return "Air heavy. Consider ventilation.", 0xFF5500
    if air_strain is not None and air_strain >= 35:
        return "Air strain rising.", 0xFFAA00
    # 5. Dry conditions
    if last_humidity is not None and last_humidity < HUMIDITY_LOW_THRESHOLD:
        return "Dry air detected.", 0xFF8800
    # 6. Just recovered from cloud (within 2 min of boot sync)
    if cloud_sync_state == "ok" and (now - last_cloud_sync_time) < 120:
        return "Recovered from cloud.", 0x00CCFF
    # 7. Motion detected (10 s display window — separate from 300 s metric window)
    if last_motion_trigger_time is not None and (now - last_motion_trigger_time) < 10:
        return "Motion detected.", 0xCCCC00
    # 8. Recovery-friendly conditions
    if recovery_score is not None and recovery_score >= 80:
        return "Recovery-friendly now.", 0x5599BB
    # 9. Readiness high
    if room_readiness is not None and room_readiness >= 80:
        if _is_evening():
            return "Readiness high. Have a nice sleep.", 0x5599BB
        return "Readiness high.", 0x00CC55
    # 10. Fresh state
    if room_state == "Fresh":
        return "Room is fresh and ready.", 0x00CC55
    if room_state == "Calm":
        return "Calm conditions for focus.", 0x4488BB
    if room_state == "Sleep-Friendly":
        return "Recovery-friendly evening room.", 0x5599BB
    if room_state == "Social":
        return "Room active. Air strain may rise.", 0xCCCC00
    if room_state == "Restless":
        return "Room conditions unbalanced.", 0xFFAA00
    return "Monitoring room conditions.", 0x444444

# -------------------------------------------------------
# Weather icon — drawn with lcd primitives at (x, y), 30x30px
# -------------------------------------------------------
def draw_weather_icon(x, y):
    desc = (outdoor_desc or "").lower()
    lcd.rect(x, y, 30, 30, CARD_TEAL, CARD_TEAL)
    if "rain" in desc or "drizzle" in desc or "shower" in desc:
        lcd.circle(x+8,  y+11, 6, 0x8899BB, 0x8899BB)
        lcd.circle(x+15, y+7,  8, 0xAABBDD, 0xAABBDD)
        lcd.circle(x+22, y+11, 6, 0x8899BB, 0x8899BB)
        lcd.rect(x+4, y+13, 22, 6, 0x99AACC, 0x99AACC)
        lcd.rect(x+6,  y+22, 2, 6, 0x4488FF, 0x4488FF)
        lcd.rect(x+14, y+22, 2, 6, 0x4488FF, 0x4488FF)
        lcd.rect(x+22, y+22, 2, 6, 0x4488FF, 0x4488FF)
    elif "cloud" in desc or "overcast" in desc:
        lcd.circle(x+7,  y+14, 7, 0x777777, 0x777777)
        lcd.circle(x+15, y+10, 9, 0xCCCCCC, 0xCCCCCC)
        lcd.circle(x+23, y+14, 7, 0x777777, 0x777777)
        lcd.rect(x+3, y+16, 24, 7, 0xAAAAAA, 0xAAAAAA)
    elif "snow" in desc:
        lcd.circle(x+15, y+15, 10, 0xDDEEFF, 0xDDEEFF)
        lcd.circle(x+15, y+15,  6, 0xEEFFFF, 0xEEFFFF)
    else:
        lcd.circle(x+15, y+15, 10, 0xFFDD33, 0xFFDD33)
        lcd.rect(x+14, y+2,  2, 4, 0xFFCC00, 0xFFCC00)
        lcd.rect(x+14, y+24, 2, 4, 0xFFCC00, 0xFFCC00)
        lcd.rect(x+2,  y+14, 4, 2, 0xFFCC00, 0xFFCC00)
        lcd.rect(x+24, y+14, 4, 2, 0xFFCC00, 0xFFCC00)

# -------------------------------------------------------
# Update functions — lcd.rect clear + lcd.print, no M5TextBox
# -------------------------------------------------------
def update_header_page1():
    wlan = network.WLAN(network.STA_IF)
    lbl_dot.setColor(0x00FF66 if wlan.isconnected() else 0xFF4444)
    lbl_date.setText(fmt_date())
    lbl_time.setText(fmt_time())
    text, color = source_badge_text_and_color()
    lbl_source.setText(text)
    lbl_source.setColor(color)

def update_header_page2():
    wlan = network.WLAN(network.STA_IF)
    lbl_dot.setColor(0x00FF66 if wlan.isconnected() else 0xFF4444)
    lbl_date.setText("")
    lbl_time.setText("")
    lbl_source.setText("")
    lcd.rect(0, 0, 320, 22, P2_HDR, P2_HDR)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print(fmt_time(), 128, 5, 0xFFFF00)
    lcd.print("COACH", 228, 5, 0x6FE8FF)

def update_readiness_card():
    score_r = room_readiness if room_readiness is not None else 0
    r_color = readiness_color(room_readiness)
    lcd.rect(4, 48, 192, 40, CARD_BLUE, CARD_BLUE)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("READINESS", 8, 26, 0x1E4A7A)
    lcd.font(lcd.FONT_DejaVu40)
    lcd.print(str(score_r) if room_readiness is not None else "--", 8, 48, r_color)
    chip_label = room_state if room_state else "---"
    chip_w = max(min(len(chip_label) * 13 + 10, 188), 40)
    chip_c = room_state_color()
    lcd.rect(4, 90, 192, 18, CARD_BLUE, CARD_BLUE)
    lcd.rect(6, 90, chip_w, 16, chip_c, chip_c)
    lcd.font(lcd.FONT_DejaVu18)
    tx = 6 + max((chip_w - len(chip_label) * 13) // 2, 2)
    lcd.print(chip_label.upper(), tx, 91, 0xFFFFFF)

def update_recovery_card():
    score_v = recovery_score if recovery_score is not None else 0
    level_text, level_color = recovery_level_label(recovery_score)
    lcd.rect(203, 44, 112, 22, CARD_TEAL, CARD_TEAL)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("RECOVERY", 205, 26, 0x1A5048)
    lcd.print(str(score_v) if recovery_score is not None else "--", 205, 46, 0x66CCFF)
    lcd.rect(203, 66, 112, 22, CARD_TEAL, CARD_TEAL)
    lcd.print(level_text, 205, 68, level_color)
    lcd.rect(203, 86, 72, 20, CARD_TEAL, CARD_TEAL)
    out_text = (str(outdoor_temp) + " C") if outdoor_temp is not None else "--"
    lcd.print(out_text, 205, 88, 0x558888)
    draw_weather_icon(284, 62)

def update_strain_tile():
    lcd.font(lcd.FONT_DejaVu18)
    lcd.rect(0, 130, 118, 22, CARD_STRAIN, CARD_STRAIN)
    lcd.print(str(air_strain) if air_strain is not None else "--", 5, 132, strain_color(air_strain))
    level_text, level_color = strain_level_label(air_strain)
    lcd.rect(0, 154, 118, 22, CARD_STRAIN, CARD_STRAIN)
    lcd.print(level_text, 5, 156, level_color)

def update_climate_tile():
    lcd.font(lcd.FONT_DejaVu18)
    lcd.rect(122, 109, 76, 22, CARD_CLIM, CARD_CLIM)
    lcd.print((str(last_temp) + " C") if last_temp is not None else "-- C", 126, 111, 0x00FFCC)
    lcd.rect(122, 132, 76, 22, CARD_CLIM, CARD_CLIM)
    lcd.print((str(int(last_humidity)) + " %") if last_humidity is not None else "-- %", 126, 134, 0x66CCFF)
    lcd.rect(122, 154, 76, 22, CARD_CLIM, CARD_CLIM)
    lcd.print(last_pressure_text + " hPa", 126, 156, 0x667788)

def update_air_tile():
    lcd.font(lcd.FONT_DejaVu18)
    aq_label, aq_color = aq_display_label(last_tvoc)
    lcd.rect(202, 109, 116, 22, CARD_AQ, CARD_AQ)
    lcd.print(aq_label, 206, 111, aq_color)
    lcd.rect(202, 132, 116, 22, CARD_AQ, CARD_AQ)
    lcd.print("CO2 " + (str(int(last_eco2)) if last_eco2 is not None else "---"), 206, 134, 0xFFCC99)
    r_text, r_color = rhythm_label()
    lcd.rect(202, 154, 116, 22, CARD_AQ, CARD_AQ)
    lcd.print(r_text, 206, 156, r_color)

def update_status_line():
    text, color = get_status_message()
    lcd.rect(0, 180, 320, 42, BG, BG)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print(text, 10, 186, color)

# -------------------------------------------------------
# Page 2 — Coach / Wellbeing
# -------------------------------------------------------
def get_coach_data():
    """Returns (action_word, subtitle, action_color, icon_type, reasons, footer).
    Priority: Ventilate > Dryness > Offline > Recovery > Calm focus > Go outside > Reset
    """
    now = utime.time()

    # 1 — Ventilate
    if (air_strain is not None and air_strain >= 60) or room_state == "Heavy":
        return ("VENTILATE", "Fresh Air Ritual", 0xFFD84D, "wind",
                ["Open a window now",
                 "Take 5 deep breaths"],
                "Done in 3 min", "DO THIS")

    # 2 — Dryness
    if (last_humidity is not None and last_humidity < HUMIDITY_LOW_THRESHOLD) \
            or room_state == "Dry":
        hum_str = str(int(last_humidity)) + "%" if last_humidity is not None else "--"
        return ("BREAK", "Hydrate + Reset", 0xFFB347, "drop",
                ["Drink a glass of water",
                 "Humidity low: " + hum_str],
                "Quick reset", "DO THIS")

    # 3 — Offline
    if network_state == "offline":
        return ("OFFLINE", "Last data shown", 0x78A6FF, "pause",
                ["Local data available",
                 "Cloud updates paused"],
                None, "STATUS")

    # 4 — Recovery-friendly evening
    if _is_evening() and recovery_score is not None and recovery_score >= 75 \
            and room_state in ("Calm", "Sleep-Friendly"):
        return ("RECOVER", "Wind-Down Ritual", 0x6FE8FF, "moon",
                ["Dim the lights",
                 "Sit quietly for 2 min"],
                "Rest well tonight", "DO THIS")

    # 5 — Calm focus
    if room_readiness is not None and room_readiness >= 75 \
            and air_strain is not None and air_strain < 40 \
            and room_state in ("Fresh", "Calm"):
        return ("FOCUS", "Focus Ritual", 0x7CFF7A, "arrow",
                ["Clear your space",
                 "Start a 20 min block"],
                "Good time to focus", "DO THIS")

    # 6 — Go outside (mild weather, daytime, inactive room)
    _wx = (outdoor_desc or "").lower()
    _wx_ok = outdoor_temp is not None and 10 <= outdoor_temp <= 22 \
             and "rain" not in _wx and "storm" not in _wx and "thunder" not in _wx
    _no_motion = last_motion_trigger_time is None or (now - last_motion_trigger_time) >= 600
    if _wx_ok and not _is_evening() and _no_motion \
            and room_state not in ("Heavy", "Dry"):
        return ("OUTSIDE", "Outdoor Break", 0x7CFF7A, "leaf",
                ["Step outside briefly",
                 "Weather is mild now"],
                "5 min outside helps", "DO THIS")

    # 7 — 3-minute reset (default)
    return ("RESET", "Reset Ritual", 0x6FE8FF, "pause",
            ["Sit and breathe slowly",
             "3 min is enough"],
            "Sit, breathe, reset", "DO THIS")


def _draw_coach_icon(icon_type, x, y, bg):
    lcd.rect(x, y, 20, 20, bg, bg)
    if icon_type == "pause":
        lcd.rect(x+3,  y+3, 5, 14, 0xFFD36A, 0xFFD36A)
        lcd.rect(x+12, y+3, 5, 14, 0xFFD36A, 0xFFD36A)
    elif icon_type == "wind":
        lcd.rect(x+1, y+4,  16, 3, 0xC8E8FF, 0xC8E8FF)
        lcd.rect(x+0, y+9,  20, 3, 0xC8E8FF, 0xC8E8FF)
        lcd.rect(x+1, y+14, 16, 3, 0xC8E8FF, 0xC8E8FF)
    elif icon_type == "moon":
        lcd.circle(x+9,  y+10, 8, 0xBBAACE, 0xBBAACE)
        lcd.circle(x+14, y+7,  7, bg, bg)
    elif icon_type == "drop":
        lcd.circle(x+10, y+13, 6, 0x88BBFF, 0x88BBFF)
        lcd.rect(x+9,  y+4, 3, 10, 0x88BBFF, 0x88BBFF)
        lcd.rect(x+7,  y+7, 7,  6, 0x88BBFF, 0x88BBFF)
    elif icon_type == "leaf":
        lcd.circle(x+10, y+7, 7, 0x55CC55, 0x55CC55)
        lcd.rect(x+9, y+13, 3, 6, 0x55CC55, 0x55CC55)
    elif icon_type == "arrow":
        lcd.rect(x+1,  y+8, 13, 4, 0xFFDD44, 0xFFDD44)
        lcd.rect(x+11, y+4, 3, 12, 0xFFDD44, 0xFFDD44)
        lcd.rect(x+8,  y+4, 6,  3, 0xFFDD44, 0xFFDD44)
        lcd.rect(x+8,  y+13,6,  3, 0xFFDD44, 0xFFDD44)


def _air_chip_bg(s):
    if s is None: return 0x223344
    if s < 30:    return 0x38C96B
    if s < 60:    return 0xF0A020
    return 0xE04B3F


def draw_page2_frame():
    lcd.clear(P2_BG)
    lcd.rect(0, 0, 320, 22, P2_HDR, P2_HDR)
    lcd.line(0, 22, 320, 22, 0x2A3B5A)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("ROOM COACH", 195, 225, 0x1A2030)


def update_page2():
    action, subtitle, action_color, icon_type, reasons, footer, section_label = get_coach_data()
    lcd.font(lcd.FONT_DejaVu18)

    # Hero card  y=24..92
    lcd.rect(6, 24, 308, 68, P2_HERO, P2_HERO)
    lcd.font(lcd.FONT_DejaVu40)
    lcd.print(action, 12, 28, action_color)
    _draw_coach_icon(icon_type, 12, 68, P2_HERO)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print(subtitle, 36, 70, 0xF4F7FF)

    # WHY / DO THIS / STATUS card  y=98..145
    lcd.rect(6, 98, 308, 47, P2_WHY, P2_WHY)
    lcd.print(section_label, 14, 101, 0x4A7AA8)
    y_r = 118
    for r in reasons[:2]:
        lcd.print(r, 14, y_r, 0xFFFFFF)
        y_r += 14

    # Score chips  y=151..181  (three 98px chips, 7px gaps: 98+7+98+7+98=308)
    r_val = str(room_readiness) if room_readiness is not None else "--"
    v_val = str(recovery_score) if recovery_score is not None else "--"
    s_val = str(air_strain)     if air_strain     is not None else "--"
    lcd.rect(6, 151, 308, 30, P2_BG, P2_BG)
    lcd.rect(6,   151, 98, 30, P2_CHIP_READY,        P2_CHIP_READY)
    lcd.rect(111, 151, 98, 30, P2_CHIP_RECOV,        P2_CHIP_RECOV)
    lcd.rect(216, 151, 98, 30, _air_chip_bg(air_strain), _air_chip_bg(air_strain))
    lcd.print("RDY " + r_val, 20,  159, 0xFFFFFF)
    lcd.print("RCV " + v_val, 125, 159, 0xFFFFFF)
    lcd.print("AIR " + s_val, 230, 159, 0xFFFFFF)

    # NEXT card  y=187..234
    lcd.rect(6, 187, 308, 47, P2_NEXT, P2_NEXT)
    lcd.print("NEXT", 14, 192, 0x4A7AA8)
    if footer:
        lcd.print(footer, 14, 210, 0xFFFFFF)
    else:
        lcd.print("--",   14, 210, 0x334E7A)


def update_clock_dot():
    wlan = network.WLAN(network.STA_IF)
    lbl_dot.setColor(0x00FF66 if wlan.isconnected() else 0xFF4444)
    lcd.rect(0, 0, 320, 22, P2_HDR, P2_HDR)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print(fmt_time(), 128, 5, 0xFFFF00)
    lcd.print("COACH", 228, 5, 0x6FE8FF)


def update_all():
    try: update_header_page1()
    except: pass
    try: update_readiness_card()
    except: pass
    try: update_recovery_card()
    except: pass
    try: update_strain_tile()
    except: pass
    try: update_climate_tile()
    except: pass
    try: update_air_tile()
    except: pass
    try: update_status_line()
    except: pass

# -------------------------------------------------------
# Boot sequence
# -------------------------------------------------------

# 0. Load flash cache — room has memory before any network call
load_last_state()
compute_room_metrics()

# 1. WiFi
draw_wifi_menu()
while True:
    if btnA.wasPressed() or btnC.wasPressed():
        if auto_connect_wifi():
            wifi_was_up = True
            send_event("room_online")
            break
        draw_wifi_menu()
    if btnB.wasPressed():
        last_ssid = load_last_wifi()
        draw_text("Last WiFi", last_ssid if last_ssid else "None saved yet", "",
                  0xFFFFFF, 0x00FFCC if last_ssid else 0xFFAA00)
        wait(2); draw_wifi_menu()
    wait_ms(50)

# 2. Draw dashboard with cached state immediately
draw_frame()
init_labels()
update_all()

# 3. NTP — sync clock, then recompute metrics with correct time
try:
    ntp_sync()
    lbl_time.setText(fmt_time())
    lbl_date.setText(fmt_date())
    compute_room_metrics()
    update_readiness_card()
    update_recovery_card()
    update_strain_tile()
    update_climate_tile()
    update_air_tile()
    update_status_line()
    save_last_state()
except: pass

# 4. Cloud sync — overwrite only if cloud data is fresher than cache
try:
    ok, err = sync_from_cloud()
    if ok:
        cloud_sync_state   = "ok"
        network_state      = "online"
        last_cloud_sync_time = utime.time()
        send_event("room_state_restored")
        cloud_norm  = (last_cloud_ts or "")[:19].replace("T", " ")
        cache_norm  = (last_cache_ts or "")[:19]
        if cloud_norm >= cache_norm:
            compute_room_metrics()
            update_all()
            save_last_state()
    else:
        cloud_sync_state = "failed"
        if last_cache_ts:
            data_source = "cache"
        update_header_page1()
except: pass

# 5. Weather — fetch and update hero outdoor info
fetch_outdoor_weather()
update_recovery_card()
save_last_state()

# -------------------------------------------------------
# Main loop
# -------------------------------------------------------
while True:
    now = utime.time()

    # A → Dashboard, B → Coach, C → manual refresh
    if btnA.wasPressed() and current_page != 1:
        current_page = 1
        draw_frame()
        update_all()
    if btnB.wasPressed() and current_page != 2:
        current_page = 2
        draw_page2_frame()
        update_header_page2()
        update_page2()
    if btnC.wasPressed():
        try:
            last_temp     = round(env3.temperature, 1)
            last_humidity = round(env3.humidity, 1)
            last_motion   = pir.state
            last_tvoc     = tvoc.TVOC
            last_eco2     = tvoc.eCO2
            try:
                last_pressure      = round(env3.pressure, 1)
                last_pressure_text = str(int(last_pressure))
            except: pass
            data_source = "live"
            compute_room_metrics()
        except: pass
        if current_page == 1:
            update_all()
        else:
            update_clock_dot()
            update_page2()

    # Clock update every second
    if current_page == 1:
        lbl_time.setText(fmt_time())
    else:
        lcd.rect(0, 0, 320, 22, P2_HDR, P2_HDR)
        lcd.font(lcd.FONT_DejaVu18)
        lcd.print(fmt_time(), 128, 5, 0xFFFF00)
        lcd.print("COACH", 228, 5, 0x6FE8FF)

    # Sensor read every 60 s
    if (now - last_read_time) >= 60:
        try:
            last_temp     = round(env3.temperature, 1)
            last_humidity = round(env3.humidity, 1)
            last_motion   = pir.state
            last_tvoc     = tvoc.TVOC
            last_eco2     = tvoc.eCO2
            try:
                last_pressure      = round(env3.pressure, 1)
                last_pressure_text = str(int(last_pressure))
            except:
                pass  # keep last known pressure
            data_source = "live"
            last_read_time = now

            # Alerts — fire once when condition appears, reset when it clears
            if last_humidity is not None:
                if last_humidity < HUMIDITY_LOW_THRESHOLD and not humidity_alerted:
                    send_event("humidity_alert", {"value": last_humidity, "threshold": HUMIDITY_LOW_THRESHOLD})
                    humidity_alerted = True
                elif last_humidity >= HUMIDITY_LOW_THRESHOLD:
                    humidity_alerted = False

            if last_tvoc is not None:
                if last_tvoc >= AQ_POOR_THRESHOLD and not aq_alerted:
                    label, _ = aq_status(last_tvoc)
                    send_event("air_quality_alert", {"value": last_tvoc, "label": label})
                    aq_alerted = True
                elif last_tvoc < AQ_POOR_THRESHOLD:
                    aq_alerted = False

            if last_motion == 1 and prev_motion == 0:
                last_motion_trigger_time = now
                send_event("motion_triggered")
                announce_on_motion()  # backend cooldowns rate-limit announcements
            prev_motion = last_motion

            compute_room_metrics()
            print("[metrics] readiness=%s recovery=%s strain=%s state=%s | temp=%s hum=%s tvoc=%s motion_recent=%s evening=%s" % (
                room_readiness, recovery_score, air_strain, room_state,
                last_temp, last_humidity, last_tvoc,
                last_motion_trigger_time is not None and (utime.time() - last_motion_trigger_time) < 300,
                _is_evening()))

        except: pass
        if current_page == 1:
            update_readiness_card()
            update_recovery_card()
            update_strain_tile()
            update_climate_tile()
            update_air_tile()
            update_status_line()
            update_header_page1()
        else:
            update_clock_dot()
            update_page2()
        save_last_state()

        # WiFi drop detection + network_state + silent retry
        try:
            _wlan_up = wifi_connected()
            network_state = "online" if _wlan_up else "offline"
            if wifi_was_up and not _wlan_up:
                wifi_was_up = False
                send_event("wifi_disconnected")
            elif not wifi_was_up and _wlan_up:
                wifi_was_up = True
            if not _wlan_up and (now - last_wifi_retry_time) >= WIFI_RETRY_EVERY:
                last_wifi_retry_time = now
                if silent_reconnect():
                    wifi_was_up = True
                    network_state = "online"
                    if current_page == 1:
                        update_header_page1()
                        update_status_line()
                    else:
                        update_clock_dot()
        except: pass

    # Telemetry every SEND_EVERY s
    if last_temp is not None and (now - last_send_time) >= SEND_EVERY:
        last_send_time = now
        try:
            import urequests, ujson
            payload = {"auth_token": AUTH_TOKEN, "device_id": DEVICE_ID,
                       "indoor_temp": last_temp, "indoor_humidity": last_humidity,
                       "air_quality": last_tvoc, "motion": (last_motion == 1),
                       "indoor_eco2": last_eco2}
            if last_pressure is not None:
                payload["indoor_pressure"] = last_pressure
            rssi = get_wifi_rssi()
            if rssi is not None:
                payload["wifi_rssi"] = rssi
            r = urequests.post(BACKEND_TELEMETRY,
                               headers={"Content-Type": "application/json",
                                        "Authorization": "Bearer " + AUTH_TOKEN},
                               data=ujson.dumps(payload))
            status = r.status_code
            r.close()
            if status in (200, 201):
                telemetry_state     = "idle"
                network_state       = "online"
                last_good_send_time = now
                send_event("room_synced")
            else:
                telemetry_state = "failed"
                send_event("room_sync_failed", {"status": status})
        except Exception as e:
            telemetry_state = "failed"
            network_state   = "offline"
            send_event("room_sync_failed", {"error": str(e)[:60]})
        if current_page == 1:
            update_header_page1()
            update_status_line()
        else:
            update_clock_dot()
            update_page2()

    # Weather refresh every WEATHER_EVERY s
    if (now - last_wx_time) >= WEATHER_EVERY:
        last_wx_time = now
        fetch_outdoor_weather()
        if current_page == 1:
            update_recovery_card()
            update_header_page1()
            update_status_line()
        else:
            update_clock_dot()
            update_page2()
        save_last_state()

    # Proactive announcements — cheap when nothing's due. Polls every 5 min
    # idle, immediately on PIR rising edge, never during quiet hours.
    announce_tick()

    wait(1)
