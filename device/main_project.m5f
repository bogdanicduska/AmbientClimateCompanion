    lcd.print(fmt_time(), 128, 5, 0xFFFF00)
    lcd.print("COACH", 228, 5, 0x6FE8FF)

def update_readiness_card():
    score_r = room_readiness if room_readiness is not None else 0
    r_color = readiness_color(room_readiness)
    lcd.rect(4, 48, 192, 40, CARD_BLUE, CARD_BLUE)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("READINESS", 8, 26, 0x1E4A7A)
    lcd.font(lcd.FONT_DejaVu40)
    lcd.print(str(score_r) if room_readiness is not None else "--", 8, 48, r_color)
    chip_label = room_state if room_state else "---"
    chip_w = max(min(len(chip_label) * 13 + 10, 188), 40)
    chip_c = room_state_color()
    lcd.rect(4, 90, 192, 18, CARD_BLUE, CARD_BLUE)
    lcd.rect(6, 90, chip_w, 16, chip_c, chip_c)
    lcd.font(lcd.FONT_DejaVu18)
    tx = 6 + max((chip_w - len(chip_label) * 13) // 2, 2)
    lcd.print(chip_label.upper(), tx, 91, 0xFFFFFF)

def update_recovery_card():
    score_v = recovery_score if recovery_score is not None else 0
    level_text, level_color = recovery_level_label(recovery_score)
    lcd.rect(203, 44, 112, 22, CARD_TEAL, CARD_TEAL)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("RECOVERY", 205, 26, 0x1A5048)
    lcd.print(str(score_v) if recovery_score is not None else "--", 205, 46, 0x66CCFF)
    lcd.rect(203, 66, 112, 22, CARD_TEAL, CARD_TEAL)
    lcd.print(level_text, 205, 68, level_color)
    lcd.rect(203, 86, 72, 20, CARD_TEAL, CARD_TEAL)
    out_text = (str(outdoor_temp) + " C") if outdoor_temp is not None else "--"
    lcd.print(out_text, 205, 88, 0x558888)
    draw_weather_icon(284, 62)

def update_strain_tile():
    lcd.font(lcd.FONT_DejaVu18)
    lcd.rect(0, 130, 118, 22, CARD_STRAIN, CARD_STRAIN)
    lcd.print(str(air_strain) if air_strain is not None else "--", 5, 132, strain_color(air_strain))
    level_text, level_color = strain_level_label(air_strain)
    lcd.rect(0, 154, 118, 22, CARD_STRAIN, CARD_STRAIN)
    lcd.print(level_text, 5, 156, level_color)

def update_climate_tile():
    lcd.font(lcd.FONT_DejaVu18)
    lcd.rect(122, 109, 76, 22, CARD_CLIM, CARD_CLIM)
    lcd.print((str(last_temp) + " C") if last_temp is not None else "-- C", 126, 111, 0x00FFCC)
    lcd.rect(122, 132, 76, 22, CARD_CLIM, CARD_CLIM)
    lcd.print((str(int(last_humidity)) + " %") if last_humidity is not None else "-- %", 126, 134, 0x66CCFF)
    lcd.rect(122, 154, 76, 22, CARD_CLIM, CARD_CLIM)
    lcd.print(last_pressure_text + " hPa", 126, 156, 0x667788)

def update_air_tile():
    lcd.font(lcd.FONT_DejaVu18)
    aq_label, aq_color = aq_display_label(last_tvoc)
    lcd.rect(202, 109, 116, 22, CARD_AQ, CARD_AQ)
    lcd.print(aq_label, 206, 111, aq_color)
    lcd.rect(202, 132, 116, 22, CARD_AQ, CARD_AQ)
    lcd.print("CO2 " + (str(int(last_eco2)) if last_eco2 is not None else "---"), 206, 134, 0xFFCC99)
    r_text, r_color = rhythm_label()
    lcd.rect(202, 154, 116, 22, CARD_AQ, CARD_AQ)
    lcd.print(r_text, 206, 156, r_color)

def update_status_line():
    text, color = get_status_message()
    lcd.rect(0, 180, 320, 42, BG, BG)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print(text, 10, 186, color)

# -------------------------------------------------------
# Page 2 — Coach / Wellbeing
# -------------------------------------------------------
def get_coach_data():
    """Returns (action_word, subtitle, action_color, icon_type, reasons, footer).
    Priority: Ventilate > Dryness > Offline > Recovery > Calm focus > Go outside > Reset
    """
    now = utime.time()

    # 1 — Ventilate
    if (air_strain is not None and air_strain >= 60) or room_state == "Heavy":
        return ("VENTILATE", "Fresh Air Ritual", 0xFFD84D, "wind",
                ["Open a window now",
                 "Take 5 deep breaths"],
                "Done in 3 min", "DO THIS")

    # 2 — Dryness
    if (last_humidity is not None and last_humidity < HUMIDITY_LOW_THRESHOLD) \
            or room_state == "Dry":
        hum_str = str(int(last_humidity)) + "%" if last_humidity is not None else "--"
        return ("BREAK", "Hydrate + Reset", 0xFFB347, "drop",
                ["Drink a glass of water",
                 "Humidity low: " + hum_str],
                "Quick reset", "DO THIS")

    # 3 — Offline
    if network_state == "offline":
        return ("OFFLINE", "Last data shown", 0x78A6FF, "pause",
                ["Local data available",
                 "Cloud updates paused"],
                None, "STATUS")

    # 4 — Recovery-friendly evening
    if _is_evening() and recovery_score is not None and recovery_score >= 75 \
            and room_state in ("Calm", "Sleep-Friendly"):
        return ("RECOVER", "Wind-Down Ritual", 0x6FE8FF, "moon",
                ["Dim the lights",
                 "Sit quietly for 2 min"],
                "Rest well tonight", "DO THIS")

    # 5 — Calm focus
    if room_readiness is not None and room_readiness >= 75 \
            and air_strain is not None and air_strain < 40 \
            and room_state in ("Fresh", "Calm"):
        return ("FOCUS", "Focus Ritual", 0x7CFF7A, "arrow",
                ["Clear your space",
                 "Start a 20 min block"],
                "Good time to focus", "DO THIS")

    # 6 — Go outside (mild weather, daytime, inactive room)
    _wx = (outdoor_desc or "").lower()
    _wx_ok = outdoor_temp is not None and 10 <= outdoor_temp <= 22 \
             and "rain" not in _wx and "storm" not in _wx and "thunder" not in _wx
    _no_motion = last_motion_trigger_time is None or (now - last_motion_trigger_time) >= 600
    if _wx_ok and not _is_evening() and _no_motion \
            and room_state not in ("Heavy", "Dry"):
        return ("OUTSIDE", "Outdoor Break", 0x7CFF7A, "leaf",
                ["Step outside briefly",
                 "Weather is mild now"],
                "5 min outside helps", "DO THIS")

    # 7 — 3-minute reset (default)
    return ("RESET", "Reset Ritual", 0x6FE8FF, "pause",
            ["Sit and breathe slowly",
             "3 min is enough"],
            "Sit, breathe, reset", "DO THIS")


def _draw_coach_icon(icon_type, x, y, bg):
    lcd.rect(x, y, 20, 20, bg, bg)
    if icon_type == "pause":
        lcd.rect(x+3,  y+3, 5, 14, 0xFFD36A, 0xFFD36A)
        lcd.rect(x+12, y+3, 5, 14, 0xFFD36A, 0xFFD36A)
    elif icon_type == "wind":
        lcd.rect(x+1, y+4,  16, 3, 0xC8E8FF, 0xC8E8FF)
        lcd.rect(x+0, y+9,  20, 3, 0xC8E8FF, 0xC8E8FF)
        lcd.rect(x+1, y+14, 16, 3, 0xC8E8FF, 0xC8E8FF)
    elif icon_type == "moon":
        lcd.circle(x+9,  y+10, 8, 0xBBAACE, 0xBBAACE)
        lcd.circle(x+14, y+7,  7, bg, bg)
    elif icon_type == "drop":
        lcd.circle(x+10, y+13, 6, 0x88BBFF, 0x88BBFF)
        lcd.rect(x+9,  y+4, 3, 10, 0x88BBFF, 0x88BBFF)
        lcd.rect(x+7,  y+7, 7,  6, 0x88BBFF, 0x88BBFF)
    elif icon_type == "leaf":
        lcd.circle(x+10, y+7, 7, 0x55CC55, 0x55CC55)
        lcd.rect(x+9, y+13, 3, 6, 0x55CC55, 0x55CC55)
    elif icon_type == "arrow":
        lcd.rect(x+1,  y+8, 13, 4, 0xFFDD44, 0xFFDD44)
        lcd.rect(x+11, y+4, 3, 12, 0xFFDD44, 0xFFDD44)
        lcd.rect(x+8,  y+4, 6,  3, 0xFFDD44, 0xFFDD44)
        lcd.rect(x+8,  y+13,6,  3, 0xFFDD44, 0xFFDD44)


def _air_chip_bg(s):
    if s is None: return 0x223344
    if s < 30:    return 0x38C96B
    if s < 60:    return 0xF0A020
    return 0xE04B3F


