# -------------------------------------------------------
# WiFi helpers  (unchanged, working)
# -------------------------------------------------------
def draw_text(msg1="", msg2="", msg3="", c1=0xFFFFFF, c2=0xAAAAAA, c3=0x888888):
    lcd.clear(0x0D0D0D)
    lcd.font(lcd.FONT_DejaVu18)
    if msg1: lcd.print(msg1, 10, 50,  c1)
    if msg2: lcd.print(msg2, 10, 90,  c2)
    if msg3: lcd.print(msg3, 10, 130, c3)

def save_last_wifi(ssid):
    try:
        with open(LAST_WIFI_FILE, "w") as f: f.write(ssid)
    except: pass

def load_last_wifi():
    try:
        with open(LAST_WIFI_FILE, "r") as f: return f.read().strip()
    except: return None

def get_wifi_order():
    last = load_last_wifi()
    ordered = [i for i in WIFI_NETWORKS if i[0] == last] if last else []
    for i in WIFI_NETWORKS:
        if i not in ordered: ordered.append(i)
    return ordered

def wait_for_connection(timeout_sec=10):
    wlan = network.WLAN(network.STA_IF)
    start = utime.time()
    while utime.time() - start < timeout_sec:
        if wlan.isconnected(): return True, wlan.ifconfig()[0]
        wait_ms(300)
    return False, None

def try_connect_one(ssid, pwd):
    draw_text("Trying WiFi...", ssid, "Please wait", 0xFFFFFF, 0x00FFCC, 0x888888)
    try:
        import wifiCfg
        wifiCfg.doConnect(ssid, pwd)
    except Exception as e:
        return False, str(e)
    ok, ip = wait_for_connection(10)
    if ok:
        save_last_wifi(ssid)
        send_event("wifi_connected", {"ssid": ssid})
        return True, ip
    return False, "Timeout"

def auto_connect_wifi():
    for ssid, pwd in get_wifi_order():
        ok, result = try_connect_one(ssid, pwd)
        if ok:
            draw_text("Connected!", ssid, "IP: " + result, 0x00FF66, 0x00FFCC, 0x88FF88)
            wait(2)
            return True
        draw_text("Failed", ssid, str(result), 0xFF4444, 0xAAAAAA, 0xFF8888)
        wait(2)
    draw_text("No WiFi connected", "All networks failed", "Check SSID/password", 0xFF4444, 0xAAAAAA, 0xFF8888)
    send_event("wifi_failed")
    return False

def draw_wifi_menu():
    lcd.clear(0x0D0D0D)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("WiFi Auto Connect", 10, 10, 0xFFFFFF)
    lcd.line(0, 34, 320, 34, 0x2A2A2A)
    y = 60
    for ssid, _ in WIFI_NETWORKS:
        lcd.print(ssid, 10, y, 0x00FFCC)
        y += 35
    lcd.print("A: Connect now",    10, 185, 0x666666)
    lcd.print("B: Show last WiFi", 10, 210, 0x666666)
    lcd.print("C: Retry all",      10, 235, 0x666666)

# -------------------------------------------------------
# NTP  (raw socket — working)
# -------------------------------------------------------
def ntp_sync():
    NTP_DELTA = 3155673600
    addr = socket.getaddrinfo("pool.ntp.org", 123)[0][-1]
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(5)
    s.sendto(b'\x1b' + 47 * b'\0', addr)
    msg, _ = s.recvfrom(48)
    s.close()
    t = struct.unpack("!I", msg[40:44])[0] - NTP_DELTA + TZ_OFFSET * 3600
    tm = utime.localtime(t)
    machine.RTC().datetime((tm[0], tm[1], tm[2], tm[6]+1, tm[3], tm[4], tm[5], 0))

def fmt_time():
    t = utime.localtime()
    return "{:02d}:{:02d}".format(t[3], t[4])

def fmt_date():
    t = utime.localtime()
    DAYS   = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"]
    MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]
    return "{} {} {}".format(DAYS[t[6]], t[2], MONTHS[t[1]-1])

def fmt_datetime():
    t = utime.localtime()
    return "{:04d}-{:02d}-{:02d} {:02d}:{:02d}:{:02d}".format(
        t[0],t[1],t[2],t[3],t[4],t[5])

# -------------------------------------------------------
# Cloud sync  (working)
# -------------------------------------------------------
def sync_from_cloud():
    global last_temp, last_humidity, last_pressure, last_pressure_text
    global last_tvoc, last_eco2, last_motion, outdoor_temp, outdoor_desc
    global outdoor_humidity, data_source, last_cloud_ts
    import urequests, ujson
    r = urequests.get(BACKEND_BASE_URL + "/latest?device_id=" + DEVICE_ID)
    status = r.status_code
    raw = r.text
    r.close()
    if status == 404:
        return True, None
    resp = ujson.loads(raw)
    if not resp.get("success"):
        return False, "API returned success=false"
    d = resp["data"]
    if d.get("indoor_temp")      is not None: last_temp     = d["indoor_temp"]
    if d.get("indoor_humidity")  is not None: last_humidity = d["indoor_humidity"]
    if d.get("indoor_pressure")  is not None:
        last_pressure = d["indoor_pressure"]
        last_pressure_text = str(int(last_pressure))
    if d.get("air_quality")      is not None: last_tvoc   = d["air_quality"]
    if d.get("indoor_eco2")      is not None: last_eco2   = d["indoor_eco2"]
    if d.get("motion")           is not None: last_motion = 1 if d["motion"] else 0
    if d.get("outdoor_temp")     is not None: outdoor_temp = d["outdoor_temp"]
    if d.get("outdoor_humidity") is not None: outdoor_humidity = d["outdoor_humidity"]
    if d.get("outdoor_weather")  is not None: outdoor_desc = d["outdoor_weather"]
    if d.get("timestamp")        is not None: last_cloud_ts = str(d["timestamp"])
    data_source = "cloud"
    return True, None

# -------------------------------------------------------
# Flash state cache
# -------------------------------------------------------
def save_last_state():
    try:
        import ujson
        state = {
            "temp": last_temp, "humidity": last_humidity,
            "pressure": last_pressure, "tvoc": last_tvoc,
            "eco2": last_eco2, "motion": bool(last_motion),
            "outdoor_temp": outdoor_temp, "outdoor_desc": outdoor_desc,
            "outdoor_humidity": outdoor_humidity,
            "timestamp": fmt_datetime(), "data_source": data_source,
            "room_readiness": room_readiness,
            "recovery_score": recovery_score,
            "air_strain": air_strain,
            "room_state": room_state,
        }
        with open(LAST_STATE_FILE, "w") as f:
            f.write(ujson.dumps(state))
    except: pass

def load_last_state():
    global last_temp, last_humidity, last_pressure, last_pressure_text
    global last_tvoc, last_eco2, last_motion, outdoor_temp, outdoor_desc
    global outdoor_humidity, data_source, last_cache_ts
    global room_readiness, recovery_score, air_strain, room_state
    try:
        import ujson
        with open(LAST_STATE_FILE, "r") as f:
            s = ujson.loads(f.read())
        if s.get("temp")             is not None: last_temp          = s["temp"]
        if s.get("humidity")         is not None: last_humidity      = s["humidity"]
        if s.get("pressure")         is not None:
            last_pressure      = s["pressure"]
            last_pressure_text = str(int(s["pressure"]))
        if s.get("tvoc")             is not None: last_tvoc          = s["tvoc"]
        if s.get("eco2")             is not None: last_eco2          = s["eco2"]
        if s.get("motion")           is not None: last_motion        = 1 if s["motion"] else 0
        if s.get("outdoor_temp")     is not None: outdoor_temp       = s["outdoor_temp"]
        if s.get("outdoor_desc")     is not None: outdoor_desc       = s["outdoor_desc"]
        if s.get("outdoor_humidity") is not None: outdoor_humidity   = s["outdoor_humidity"]
        if s.get("room_readiness")   is not None: room_readiness     = s["room_readiness"]
        if s.get("recovery_score")   is not None: recovery_score     = s["recovery_score"]
        if s.get("air_strain")       is not None: air_strain         = s["air_strain"]
        if s.get("room_state")       is not None: room_state         = s["room_state"]
        last_cache_ts = s.get("timestamp")
        data_source = "cache"
        return last_cache_ts
    except:
        return None

# -------------------------------------------------------
# Events + WiFi helpers
# -------------------------------------------------------
def wifi_connected():
    try:
        return network.WLAN(network.STA_IF).isconnected()
    except:
        return False

def silent_reconnect():
    try:
        import wifiCfg
        ssid, pwd = get_wifi_order()[0]
        wifiCfg.doConnect(ssid, pwd)
        ok, _ = wait_for_connection(8)
        if ok:
            save_last_wifi(ssid)
        return ok
    except:
        return False

def get_wifi_rssi():
    try:
        return network.WLAN(network.STA_IF).status("rssi")
    except:
        return None

def send_event(event_type, details=None):
    try:
        import urequests, ujson
        payload = {"device_id": DEVICE_ID, "event_type": event_type}
        if details is not None:
            payload["details"] = details
        r = urequests.post(BACKEND_EVENTS,
                           headers={"Content-Type": "application/json",
                                    "Authorization": "Bearer " + AUTH_TOKEN},
                           data=ujson.dumps(payload))
        r.close()
    except: pass

# -------------------------------------------------------
# Weather / forecast  (working)
# -------------------------------------------------------
def fetch_outdoor_weather():
    global outdoor_temp, outdoor_desc, outdoor_humidity, weather_state, last_good_wx_time
    try:
        import urequests, ujson
        r = urequests.get("https://api.openweathermap.org/data/2.5/weather?q=" +
                          OWM_CITY + "&appid=" + OWM_API_KEY + "&units=metric")
        raw = r.text; r.close()
        d = ujson.loads(raw)
        outdoor_temp     = round(d["main"]["temp"], 1)
        outdoor_desc     = d["weather"][0]["description"]
        outdoor_humidity = d["main"]["humidity"]
        weather_state    = "fresh"
        last_good_wx_time = utime.time()
    except:
        if outdoor_temp is not None:
            weather_state = "stale"
        else:
            weather_state = "failed"

def fetch_forecast():
    global forecast
    try:
        import urequests, ujson
        r = urequests.get("https://api.openweathermap.org/data/2.5/forecast?q=" +
                          OWM_CITY + "&appid=" + OWM_API_KEY + "&units=metric&cnt=40")
        raw = r.text; r.close()
        d = ujson.loads(raw)
        today_t   = utime.localtime()
        today_str = "{:04d}-{:02d}-{:02d}".format(today_t[0], today_t[1], today_t[2])
        days = {}
        for item in d["list"]:
            date = item["dt_txt"][:10]
            if date == today_str: continue
            temp = item["main"]["temp"]
            desc = item["weather"][0]["main"]
            if date not in days:
                days[date] = {"min": temp, "max": temp, "desc": desc}
            else:
                if temp < days[date]["min"]: days[date]["min"] = temp
                if temp > days[date]["max"]: days[date]["max"] = temp
        forecast = []
        for date in sorted(days.keys())[:3]:
            dd = days[date]
            DAYS2 = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"]
            try:
                import utime as _t
                parts = date.split("-")
                wday  = _t.localtime(_t.mktime((int(parts[0]),int(parts[1]),int(parts[2]),0,0,0,0,0)))[6]
                dname = DAYS2[wday]
            except:
                dname = date[5:]
            forecast.append({"day": dname, "min": round(dd["min"],1),
                              "max": round(dd["max"],1), "desc": dd["desc"][:7]})
    except: pass

# -------------------------------------------------------
# Room performance metrics — aligned with backend canonical formulas.
#
# These are LOCAL estimates computed from live sensors for immediate
# display between telemetry sends (every 5 minutes). The backend
# (room_metrics_service.py) is the source of truth — it re-computes
# and stores canonical scores on every telemetry ingest. The dashboard
# always shows backend-computed scores.
#
# Room Readiness  (0-100) — focus/presence. Ideal: 21°C, 50% RH, clean air.
# Recovery Score  (0-100) — rest/calm.     Ideal: 20°C, 52% RH, clean air.
# Air Strain      (0-100) — heaviness.     Rises with TVOC, eCO2, heat > 22°C.
# Room State      — Dry | Heavy | Social | Fresh | Sleep-Friendly | Calm | Restless
# -------------------------------------------------------

def _is_evening():
    h = utime.localtime()[3]
    return h >= 20 or h < 7

def _air_score(tvoc, eco2):
    # Shared air quality penalty used by readiness and recovery.
    aq_pen  = min(100.0, tvoc / 2.0)
    co2_pen = min(100.0, max(0.0, (eco2 - 400) / 16.0))
    return max(0.0, 100.0 - (aq_pen * 0.60 + co2_pen * 0.40))

def compute_room_metrics():
    global room_readiness, recovery_score, air_strain, room_state

    if last_tvoc is None or last_temp is None or last_humidity is None:
        room_state = "---"
        return

    motion_recent = last_motion_trigger_time is not None and (utime.time() - last_motion_trigger_time) < 300
    eco2 = last_eco2 or 400.0
    air_s = _air_score(last_tvoc, eco2)

    # Room Readiness — ideal 21°C, 50% RH. Weights: temp 40%, RH 25%, air 35%.
    temp_r = max(0.0, 100.0 - abs(last_temp - 21.0) * 8.0)
    hum_r  = max(0.0, 100.0 - abs(last_humidity - 50.0) * 2.5)
    room_readiness = max(0, min(100, int(temp_r * 0.40 + hum_r * 0.25 + air_s * 0.35)))

    # Recovery Score — ideal 20°C, 52% RH. Weights: temp 35%, RH 30%, air 35%.
    temp_v = max(0.0, 100.0 - abs(last_temp - 20.0) * 10.0)
    hum_v  = max(0.0, 100.0 - abs(last_humidity - 52.0) * 3.0)
    recovery_score = max(0, min(100, int(temp_v * 0.35 + hum_v * 0.30 + air_s * 0.35)))

    # Air Strain — TVOC 50%, eCO2 35%, heat above 22°C 15%.
    aq_f   = min(100.0, last_tvoc / 2.0)
    co2_f  = min(100.0, max(0.0, (eco2 - 400) / 16.0))
    temp_f = min(100.0, max(0.0, (last_temp - 22.0) * 5.0)) if last_temp > 22.0 else 0.0
    air_strain = max(0, min(100, int(aq_f * 0.50 + co2_f * 0.35 + temp_f * 0.15)))

    # Room State — priority: Dry → Heavy → Social → Fresh → Sleep-Friendly → Calm → Restless
    if last_humidity < HUMIDITY_LOW_THRESHOLD:
        room_state = "Dry"
    elif air_strain >= 65:
        room_state = "Heavy"
    elif motion_recent or last_motion == 1:
        room_state = "Social"
    elif air_strain < 25 and 40 <= last_humidity <= 70:
        room_state = "Fresh"
    elif recovery_score >= 70:
        room_state = "Sleep-Friendly"
    elif recovery_score >= 55:
        room_state = "Calm"
    elif air_strain >= 45:
        room_state = "Restless"
    else:
        room_state = "Calm"

def debug_room_state_choice():
    try:
        now_hour = utime.localtime()[3]
    except:
        now_hour = -1

    motion_recent = (
        last_motion_trigger_time is not None and
        (utime.time() - last_motion_trigger_time) < 300
    )

    print("----- ROOM STATE DEBUG -----")
    print("time=", fmt_time(), "hour=", now_hour, "evening=", _is_evening())
    print("temp=", last_temp,
          "humidity=", last_humidity,
          "tvoc=", last_tvoc,
          "eco2=", last_eco2,
          "motion=", last_motion,
          "motion_recent=", motion_recent)
    print("readiness=", room_readiness,
          "recovery=", recovery_score,
          "strain=", air_strain)

    if last_humidity is not None and last_humidity < HUMIDITY_LOW_THRESHOLD:
        print("chosen_by=DRY because humidity <", HUMIDITY_LOW_THRESHOLD)
    elif last_tvoc is not None and (last_tvoc >= AQ_POOR_THRESHOLD or (air_strain is not None and air_strain >= 65)):
        print("chosen_by=HEAVY because tvoc>=threshold or strain>=65")
    elif motion_recent or last_motion == 1:
        print("chosen_by=SOCIAL because motion_recent or motion==1")
    elif _is_evening() and recovery_score is not None and recovery_score >= 65:
        print("chosen_by=SLEEP-FRIENDLY because evening and recovery>=65")
    elif recovery_score is not None and recovery_score >= 70:
        print("chosen_by=CALM because recovery>=70")
    elif room_readiness is not None and room_readiness >= 70:
        print("chosen_by=FRESH because readiness>=70")
    else:
        print("chosen_by=RESTLESS fallback")
    print("----------------------------")

# -------------------------------------------------------
# AQ helpers
# -------------------------------------------------------
def aq_status(tvoc_val):
    if tvoc_val is None:               return "N/A",       0x444444
    if tvoc_val < 100:                 return "GOOD",      0x006633
    if tvoc_val < AQ_POOR_THRESHOLD:   return "MODERATE",  0x886600
    if tvoc_val < AQ_HAZARD_THRESHOLD: return "POOR",      0xAA4400
    return "HAZARDOUS", 0xAA0000

def aq_display_label(tvoc_val):
    if tvoc_val is None:               return "N/A",  0x444444
    if tvoc_val < 100:                 return "GOOD", 0x006633
    if tvoc_val < AQ_POOR_THRESHOLD:   return "MOD",  0x886600
    if tvoc_val < AQ_HAZARD_THRESHOLD: return "POOR", 0xAA4400
    return "HAZ", 0xAA0000

# -------------------------------------------------------
# UI  —  WHOOP-for-Room dashboard layout
# -------------------------------------------------------
#
#  320 x 240
#  ┌─────────────────────────────────────────┐  y=0
#  │  ● Thu 23 Apr  15:11             LIVE  │  y=0-22   header
#  ├──────────────────────┬──────────────────┤  y=23
#  │  READINESS           │  RECOVERY        │  y=24-107 hero
#  │       82             │    76            │
#  │  [  FRESH  ]         │    Good          │
#  │                      │    Out: 9.3 C    │
#  ├──────┬───────────────┴──────┬───────────┤  y=108
#  │STRAIN│ 22.4 C               │ TVOC 118  │  y=109-177 tiles
#  │  31  │  48 %                │ CO2  540  │
#  │ Low  │ 1026 hPa             │ Active    │
#  ├──────┴──────────────────────┴───────────┤  y=178
#  │  Room is fresh and ready.               │  y=179-239 insight
#  │                         ROOM RHYTHM     │
#  └─────────────────────────────────────────┘

BG           = 0x080C10
CARD_BLUE    = 0x0E2840   # readiness hero
CARD_TEAL    = 0x0A2220   # recovery hero
CARD_STRAIN  = 0x1C1028   # strain tile
CARD_CLIM    = 0x0D1A22   # climate tile
CARD_AQ      = 0x0C1C12   # AQ tile
P2_BG    = 0x0B1220   # page 2 background
P2_HDR   = 0x111A2A   # header bar
P2_HERO  = 0x1C3460   # hero card  — brightest layer
P2_WHY   = 0x101E30   # why card   — mid layer
P2_NEXT  = 0x0C1420   # next card  — darkest layer
P2_CHIP_READY = 0xD4A91F
P2_CHIP_RECOV = 0x3CAEDB

def draw_frame():
    lcd.clear(BG)
    # Hero cards (1px BG gap acts as divider)
    lcd.rect(0,   23, 200,  85, CARD_BLUE,   CARD_BLUE)
    lcd.rect(201, 23, 119,  85, CARD_TEAL,   CARD_TEAL)
    # Tile cards  (strain 120px, climate 79px, AQ 119px)
    lcd.rect(0,   109, 120, 69, CARD_STRAIN, CARD_STRAIN)
    lcd.rect(121, 109,  79, 69, CARD_CLIM,   CARD_CLIM)
    lcd.rect(201, 109, 119, 69, CARD_AQ,     CARD_AQ)
    # Static section labels
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("READINESS", 8,  26, 0x1E4A7A)
    lcd.print("STRAIN",    5, 111, 0x4A3070)
    # Watermark
    lcd.print("ROOM RHYTHM", 175, 224, 0x1A1A1A)

# Header labels (M5TextBox — sit on BG, safe to update)
lbl_dot = lbl_date = lbl_time = lbl_source = None

def init_labels():
    global lbl_dot, lbl_date, lbl_time, lbl_source
    lbl_dot    = M5TextBox(6,   5, "*",          lcd.FONT_DejaVu18, 0x00FF66)
    lbl_date   = M5TextBox(22,  5, "--- -- ---", lcd.FONT_DejaVu18, 0x888888)
    lbl_source = M5TextBox(222, 5, "LIVE",        lcd.FONT_DejaVu18, 0x00FF66)
    lbl_time   = M5TextBox(148, 5, "--:--",      lcd.FONT_DejaVu18, 0xFFFF00)

# -------------------------------------------------------
# UI helpers
# -------------------------------------------------------
def source_badge_text_and_color():
    if network_state == "offline":
        return "OFFLN",   0xFF4444
    if telemetry_state == "failed":
        return "TX ERR",  0xFF8800
    if weather_state in ("stale", "failed"):
        if data_source == "live":
            return "WX STL", 0xFFCC00
        return "WX OLD",  0xFFCC00
    if data_source == "cloud":
        return "CLOUD",     0xFFCC00
    if data_source == "cache":
        return "CACHE",     0x888888
    return "LIVE", 0x00FF66

def room_state_color():
    colors = {
        "Fresh":         0x0A5C2A,
        "Calm":          0x1E3D5C,
        "Dry":           0x7A5A00,
        "Heavy":         0xAA2200,
        "Social":        0x6B6600,
        "Sleep-Friendly":0x1A304A,
        "Restless":      0x884400,
    }
    return colors.get(room_state, 0x333333)

def readiness_color(score):
    if score is None:  return 0x555555
    if score >= 75:    return 0x00CC55
    if score >= 50:    return 0xFFCC00
    return 0xFF5500

def recovery_level_label(score):
    if score is None:  return "---",    0x555555
    if score >= 75:    return "Good",   0x00BBCC
    if score >= 50:    return "Fair",   0xFFCC00
    return "Low",   0xFF7700

def strain_level_label(score):
    if score is None:  return "---",     0x555555
    if score < 30:     return "Low",     0x00CC55
    if score < 60:     return "Rising",  0xFFAA00
    return "High",  0xFF3300

def strain_color(score):
    if score is None:  return 0x555555
    if score < 30:     return 0x00CC55
    if score < 60:     return 0xFFAA00
    return 0xFF3300

def rhythm_label():
    now = utime.time()
    if last_motion_trigger_time is not None and now - last_motion_trigger_time < 300:
        return "Active", 0x00CC55
    if last_motion == 1:
        return "Present", 0x88AA00
    return "Quiet", 0x444444

def get_status_message():
    now = utime.time()
    # 1. Offline
    if network_state == "offline":
        return "Offline. Showing last known values.", 0xFF4444
    # 2. Sync failed
    if telemetry_state == "failed":
        return "Sync failed. Data may be stale.", 0xFF7700
    # 3. Weather stale
    if weather_state in ("stale", "failed"):
        return "Weather data outdated.", 0xFFAA00
    # 4. Air strain rising
    if air_strain is not None and air_strain >= 60:
        return "Air heavy. Consider ventilation.", 0xFF5500
    if air_strain is not None and air_strain >= 35:
        return "Air strain rising.", 0xFFAA00
    # 5. Dry conditions
    if last_humidity is not None and last_humidity < HUMIDITY_LOW_THRESHOLD:
        return "Dry air detected.", 0xFF8800
    # 6. Just recovered from cloud (within 2 min of boot sync)
    if cloud_sync_state == "ok" and (now - last_cloud_sync_time) < 120:
        return "Recovered from cloud.", 0x00CCFF
    # 7. Motion detected (10 s display window — separate from 300 s metric window)
    if last_motion_trigger_time is not None and (now - last_motion_trigger_time) < 10:
        return "Motion detected.", 0xCCCC00
    # 8. Recovery-friendly conditions
    if recovery_score is not None and recovery_score >= 80:
        return "Recovery-friendly now.", 0x5599BB
    # 9. Readiness high
    if room_readiness is not None and room_readiness >= 80:
        if _is_evening():
            return "Readiness high. Have a nice sleep.", 0x5599BB
        return "Readiness high.", 0x00CC55
    # 10. Fresh state
    if room_state == "Fresh":
        return "Room is fresh and ready.", 0x00CC55
    if room_state == "Calm":
        return "Calm conditions for focus.", 0x4488BB
    if room_state == "Sleep-Friendly":
        return "Recovery-friendly evening room.", 0x5599BB
    if room_state == "Social":
        return "Room active. Air strain may rise.", 0xCCCC00
    if room_state == "Restless":
        return "Room conditions unbalanced.", 0xFFAA00
    return "Monitoring room conditions.", 0x444444

# -------------------------------------------------------
# Weather icon — drawn with lcd primitives at (x, y), 30x30px
# -------------------------------------------------------
def draw_weather_icon(x, y):
    desc = (outdoor_desc or "").lower()
    lcd.rect(x, y, 30, 30, CARD_TEAL, CARD_TEAL)
    if "rain" in desc or "drizzle" in desc or "shower" in desc:
        lcd.circle(x+8,  y+11, 6, 0x8899BB, 0x8899BB)
        lcd.circle(x+15, y+7,  8, 0xAABBDD, 0xAABBDD)
        lcd.circle(x+22, y+11, 6, 0x8899BB, 0x8899BB)
        lcd.rect(x+4, y+13, 22, 6, 0x99AACC, 0x99AACC)
        lcd.rect(x+6,  y+22, 2, 6, 0x4488FF, 0x4488FF)
        lcd.rect(x+14, y+22, 2, 6, 0x4488FF, 0x4488FF)
        lcd.rect(x+22, y+22, 2, 6, 0x4488FF, 0x4488FF)
    elif "cloud" in desc or "overcast" in desc:
        lcd.circle(x+7,  y+14, 7, 0x777777, 0x777777)
        lcd.circle(x+15, y+10, 9, 0xCCCCCC, 0xCCCCCC)
        lcd.circle(x+23, y+14, 7, 0x777777, 0x777777)
        lcd.rect(x+3, y+16, 24, 7, 0xAAAAAA, 0xAAAAAA)
    elif "snow" in desc:
        lcd.circle(x+15, y+15, 10, 0xDDEEFF, 0xDDEEFF)
        lcd.circle(x+15, y+15,  6, 0xEEFFFF, 0xEEFFFF)
    else:
        lcd.circle(x+15, y+15, 10, 0xFFDD33, 0xFFDD33)
        lcd.rect(x+14, y+2,  2, 4, 0xFFCC00, 0xFFCC00)
        lcd.rect(x+14, y+24, 2, 4, 0xFFCC00, 0xFFCC00)
        lcd.rect(x+2,  y+14, 4, 2, 0xFFCC00, 0xFFCC00)
        lcd.rect(x+24, y+14, 4, 2, 0xFFCC00, 0xFFCC00)

