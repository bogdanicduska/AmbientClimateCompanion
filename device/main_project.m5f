BG = 0x0D0D0D

def draw_frame():
    lcd.clear(BG)
    # Horizontal dividers
    lcd.line(0,  25, 320,  25, 0x2A2A2A)
    lcd.line(0, 100, 320, 100, 0x2A2A2A)
    lcd.line(0, 138, 320, 138, 0x2A2A2A)
    lcd.line(0, 180, 320, 180, 0x2A2A2A)
    # Indoor column dividers
    lcd.line(107, 101, 107, 137, 0x222222)
    lcd.line(213, 101, 213, 137, 0x222222)
    # Forecast column dividers
    lcd.line(107, 182, 107, 239, 0x222222)
    lcd.line(213, 182, 213, 239, 0x222222)
    # Indoor static micro-labels (top of each column)
    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("TEMP",   12, 102, 0x555555)
    lcd.print("HUMID", 118, 102, 0x555555)
    lcd.print("PRESS", 222, 102, 0x555555)

# Labels are created in init_labels() after draw_frame() — not at module level
lbl_dot = lbl_date = lbl_time = None
lbl_out_temp = lbl_out_unit = lbl_out_cond = lbl_out_hum = None
lbl_in_temp = lbl_in_hum = lbl_in_press = None
lbl_aq_val = lbl_eco2 = None
lbl_fc_day = lbl_fc_temp = lbl_fc_desc = [None]*3

def init_labels():
    global lbl_dot, lbl_date, lbl_time
    global lbl_out_temp, lbl_out_unit, lbl_out_cond, lbl_out_hum
    global lbl_in_temp, lbl_in_hum, lbl_in_press
    global lbl_aq_val, lbl_eco2
    global lbl_fc_day, lbl_fc_temp, lbl_fc_desc

    # Header
    lbl_dot  = M5TextBox(6,   5, "*",           lcd.FONT_DejaVu18, 0x00FF66)
    lbl_date = M5TextBox(22,  5, "--- -- ---",  lcd.FONT_DejaVu18, 0x888888)
    lbl_time = M5TextBox(245, 5, "--:--",       lcd.FONT_DejaVu18, 0xFFFF00)

    # Hero outdoor: big temp + unit + condition + humidity
    lbl_out_temp = M5TextBox(35,  32, "--.-",    lcd.FONT_DejaVu40, 0xFFFFFF)
    lbl_out_unit = M5TextBox(165, 55, "C",       lcd.FONT_DejaVu18, 0xAAAAAA)
    lbl_out_cond = M5TextBox(10,  80, "---",     lcd.FONT_DejaVu18, 0x6699BB)
    lbl_out_hum  = M5TextBox(220, 80, "HUM --%", lcd.FONT_DejaVu18, 0x888888)

    # Indoor strip values
    lbl_in_temp  = M5TextBox(12,  119, "--.-C",    lcd.FONT_DejaVu18, 0x00FFCC)
    lbl_in_hum   = M5TextBox(118, 119, "-- %",     lcd.FONT_DejaVu18, 0x66CCFF)
    lbl_in_press = M5TextBox(222, 119, "---- hPa", lcd.FONT_DejaVu18, 0x99CCFF)

    # AQ strip (chip drawn manually; these are the text beside it)
    lbl_aq_val = M5TextBox(130, 153, "--- ppb",   lcd.FONT_DejaVu18, 0xCCCCCC)
    lbl_eco2   = M5TextBox(215, 153, "eCO2 ---",  lcd.FONT_DejaVu18, 0xFFCC99)

    # Forecast 3 columns
    lbl_fc_day  = [M5TextBox(12+i*107, 186, "---",   lcd.FONT_DejaVu18, 0xAAAAAA) for i in range(3)]
    lbl_fc_temp = [M5TextBox(12+i*107, 206, "--/--", lcd.FONT_DejaVu18, 0x88CCFF) for i in range(3)]
    lbl_fc_desc = [M5TextBox(12+i*107, 224, "---",   lcd.FONT_DejaVu18, 0x777777) for i in range(3)]

# -------------------------------------------------------
# Update functions — setText only, no lcd.clear
# -------------------------------------------------------
def update_header():
    wlan = network.WLAN(network.STA_IF)
    lbl_dot.setColor(0x00FF66 if wlan.isconnected() else 0xFF4444)
    lbl_date.setText(fmt_date())
    lbl_time.setText(fmt_time())

def update_outdoor():
    if outdoor_temp is not None:
        lbl_out_temp.setText(str(outdoor_temp))
    lbl_out_cond.setText((outdoor_desc or "---")[:20])
    if outdoor_humidity is not None:
        lbl_out_hum.setText("HUM " + str(int(outdoor_humidity)) + "%")

def update_indoor():
    if last_temp is not None:
        lbl_in_temp.setText(str(last_temp) + "C")
    else:
        lbl_in_temp.setText("--.-C")
    if last_humidity is not None:
        lbl_in_hum.setText(str(int(last_humidity)) + " %")
    else:
        lbl_in_hum.setText("-- %")
    lbl_in_press.setText(last_pressure_text + " hPa")

def update_aq():
    status, color = aq_status(last_tvoc)
    # Chip drawn as a filled rect, text printed on top (no label overwrite issues)
    lcd.rect(10, 147, 110, 24, color, color)
    lcd.font(lcd.FONT_DejaVu18)
    text_x = 10 + (110 - len(status) * 11) // 2
    if text_x < 12: text_x = 12
    lcd.print(status, text_x, 151, 0xFFFFFF)
    lbl_aq_val.setText((str(int(last_tvoc)) if last_tvoc is not None else "---") + " ppb")
    lbl_eco2.setText("eCO2 " + (str(int(last_eco2)) if last_eco2 is not None else "---"))

def update_forecast():
    for i in range(3):
        if i < len(forecast):
            f = forecast[i]
            lbl_fc_day[i].setText(f["day"])
            lbl_fc_temp[i].setText(str(f["min"]) + "/" + str(f["max"]))
            lbl_fc_desc[i].setText(f["desc"][:8])
        else:
            lbl_fc_day[i].setText("---")
            
            lbl_fc_temp[i].setText("--/--")
            lbl_fc_desc[i].setText("---")

def update_all():
    try: update_header()
    except: pass
    try: update_outdoor()
    except: pass
    try: update_indoor()
    except: pass
    try: update_aq()
    except: pass
    try: update_forecast()
    except: pass

# -------------------------------------------------------
# Boot sequence
# -------------------------------------------------------

# 1. WiFi
draw_wifi_menu()
while True:
    if btnA.wasPressed() or btnC.wasPressed():
        if auto_connect_wifi():
            send_event("boot_recovered")
            break
        draw_wifi_menu()
    if btnB.wasPressed():
        last_ssid = load_last_wifi()
        draw_text("Last WiFi", last_ssid if last_ssid else "None saved yet", "",
                  0xFFFFFF, 0x00FFCC if last_ssid else 0xFFAA00)
        wait(2); draw_wifi_menu()
    wait_ms(50)

# 2. NTP
draw_text("Syncing time...", "", "", 0xFFCC00)
try:
    ntp_sync()
    draw_text("Time synced", fmt_datetime(), "", 0x00FF66, 0x00FFCC)
except Exception as e:
    draw_text("Time sync failed", str(e)[:30], "Continuing...", 0xFF8800, 0xAAAAAA, 0x888888)
wait(1)

# 3. Cloud sync
draw_text("Fetching cloud data...", "", "", 0xFFCC00)
try:
    ok, err = sync_from_cloud()
    if ok:
        ts_disp = (last_cloud_ts[:16].replace("T", " ")) if last_cloud_ts else "no timestamp"
        l1 = "Last: " + ts_disp
        l2 = "T:" + (str(last_temp) if last_temp is not None else "-") + \
             " H:" + (str(int(last_humidity)) if last_humidity is not None else "-") + "%" + \
             " TVOC:" + (str(int(last_tvoc)) if last_tvoc is not None else "-")
        send_event("cache_loaded")
        draw_text("Cloud sync OK", l1, l2, 0x00FF66, 0x00FFCC, 0x88FF88)
        wait(7)
    else:
        draw_text("Cloud sync failed", err or "Unknown error", "Continuing...", 0xFF8800, 0xAAAAAA, 0x888888)
        wait(2)
except Exception as e:
    err_msg = str(e)
    draw_text("Cloud sync error", err_msg[:28], err_msg[28:56], 0xFF4444, 0xFFAA00, 0x888888)
    wait(4)

# 4. Live weather
draw_text("Fetching weather...", "", "", 0xFFCC00)
fetch_outdoor_weather()
fetch_forecast()

# 5. Draw dashboard
draw_frame()
init_labels()
update_all()

# -------------------------------------------------------
# Main loop
# -------------------------------------------------------
while True:
    now = utime.time()

    # Clock update every second
    lbl_time.setText(fmt_time())

    # Sensor read every 60 s
    if (now - last_read_time) >= 60:
        try:
            last_temp     = round(env3.temperature, 1)
            last_humidity = round(env3.humidity, 1)
            last_motion   = pir.state
            last_tvoc     = tvoc.TVOC
            last_eco2     = tvoc.eCO2
            try:
                last_pressure      = round(env3.pressure, 1)
                last_pressure_text = str(int(last_pressure))
            except:
                last_pressure      = None
                last_pressure_text = "---"
            data_source = "live"
            last_read_time = now

            # Alerts — fire once when condition appears, reset when it clears
            if last_humidity is not None:
                if last_humidity < HUMIDITY_LOW_THRESHOLD and not humidity_alerted:
                    send_event("humidity_alert", {"value": last_humidity, "threshold": HUMIDITY_LOW_THRESHOLD})
                    humidity_alerted = True
                elif last_humidity >= HUMIDITY_LOW_THRESHOLD:
                    humidity_alerted = False

            if last_tvoc is not None:
                if last_tvoc >= AQ_POOR_THRESHOLD and not aq_alerted:
                    label, _ = aq_status(last_tvoc)
                    send_event("air_quality_alert", {"value": last_tvoc, "label": label})
                    aq_alerted = True
                elif last_tvoc < AQ_POOR_THRESHOLD:
                    aq_alerted = False

            if last_motion == 1 and prev_motion == 0:
                send_event("motion_triggered")
            prev_motion = last_motion

        except: pass
        update_indoor()
        update_aq()
        update_header()

        # WiFi drop detection
        try:
            _wlan_up = network.WLAN(network.STA_IF).isconnected()
            if wifi_was_up and not _wlan_up:
                wifi_was_up = False
                send_event("wifi_disconnected")
            elif not wifi_was_up and _wlan_up:
                wifi_was_up = True
        except: pass

    # Telemetry every SEND_EVERY s
    if last_temp is not None and (now - last_send_time) >= SEND_EVERY:
        last_send_time = now
        try:
            import urequests, ujson
            payload = {"auth_token": AUTH_TOKEN, "device_id": DEVICE_ID,
                       "indoor_temp": last_temp, "indoor_humidity": last_humidity,
                       "air_quality": last_tvoc, "motion": (last_motion == 1),
                       "indoor_eco2": last_eco2}
            if last_pressure is not None:
                payload["indoor_pressure"] = last_pressure
            rssi = get_wifi_rssi()
            if rssi is not None:
                payload["wifi_rssi"] = rssi
            r = urequests.post(BACKEND_TELEMETRY,
                               headers={"Content-Type": "application/json",
                                        "Authorization": "Bearer " + AUTH_TOKEN},
                               data=ujson.dumps(payload))
            status = r.status_code
            r.close()
            if status in (200, 201):
                send_event("cloud_sync_ok")
            else:
                send_event("cloud_sync_failed", {"status": status})
        except Exception as e:
            send_event("cloud_sync_failed", {"error": str(e)[:60]})

    # Weather refresh every WEATHER_EVERY s
    if (now - last_wx_time) >= WEATHER_EVERY:
        last_wx_time = now
        fetch_outdoor_weather()
        fetch_forecast()
        update_outdoor()
        update_forecast()

    wait(1)
