    lcd.font(lcd.FONT_DejaVu18)
    lcd.print("READINESS", 8,  26, 0x1E4A7A)
    lcd.print("STRAIN",    5, 111, 0x4A3070)
    # Watermark
    lcd.print("ROOM RHYTHM", 175, 224, 0x1A1A1A)

