# ============================================================
# Room Rhythm — dashboard environment variables
# Copy to .env and fill in values, or set directly in Cloud Run.
# ============================================================

# Backend API base URL (no trailing slash)
BACKEND_URL=https://ambient-climate-backend-977755576323.europe-west6.run.app/api/v1

# Default device shown in the sidebar (can be changed at runtime)
DEVICE_ID=m5stack-duska-home

# Comma-separated list of devices available in the sidebar selector
KNOWN_DEVICES=m5stack-duska-home,m5stack-ana-home
